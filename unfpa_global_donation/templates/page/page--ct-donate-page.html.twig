{#
/**
 * @file
 * Default theme implementation to display a single page.
 *
 * The doctype, html, head and body tags are not in this template. Instead they
 * can be found in the html.html.twig template in this directory.
 *
 * Available variables:
 *
 * General utility variables:
 * - base_path: The base URL path of the Drupal installation. Will usually be
 *   "/" unless you have installed Drupal in a sub-directory.
 * - is_front: A flag indicating if the current page is the front page.
 * - logged_in: A flag indicating if the user is registered and signed in.
 * - is_admin: A flag indicating if the user has permission to access
 *   administration pages.
 *
 * Site identity:
 * - front_page: The URL of the front page. Use this instead of base_path when
 *   linking to the front page. This includes the language domain or prefix.
 *
 * Page content (in order of occurrence in the default page.html.twig):
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title: The page title, for use in the actual content.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - messages: Status and error messages. Should be displayed prominently.
 * - tabs: Tabs linking to any sub-pages beneath the current page (e.g., the
 *   view and edit tabs when displaying a node).
 * - node: Fully loaded node, if there is an automatically-loaded node
 *   associated with the page and the node ID is the second argument in the
 *   page's path (e.g. node/12345 and node/12345/revisions, but not
 *   comment/reply/12345).
 *
 * Regions:
 * - page.header: Items for the header region.
 * - page.navigation: Items for the navigation region.
 * - page.navigation_collapsible: Items for the navigation (collapsible) region.
 * - page.highlighted: Items for the highlighted content region.
 * - page.help: Dynamic help text, mostly for admin pages.
 * - page.content: The main content of the current page.
 * - page.sidebar_first: Items for the first sidebar.
 * - page.sidebar_second: Items for the second sidebar.
 * - page.footer: Items for the footer region.
 *
 * @ingroup templates
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}
{% set module_path = bamboo_path_system('module', 'unfpa_global_donation') %}

{# Main #}
{% block main %}
  <!-- Header section -->
{% set dp_banner_title = dp_banner_main_title|striptags|render %}
{% set dp_banner_sub_title = dp_banner_sub_title|render %}
  {% if dp_effect_type == 'withoutHeader' %}
    <header class="clearfix">
      <a class="logo"><img src="/{{ module_path }}/images/unfpa_logo.svg" /></a>
      <a href="#makeDonation" class="primary-btn"> {{ 'Donate Now'|t }} </a>
    </header>
    <!-- Banner section -->
    <section class="banner-blk">
      <img class="withoutHeader" src="{{ dp_banner_desktop }}" title="{{ dp_banner_title }}" alt="{{ dp_banner_title }}" />
      <div class="text">
        <h2>
          {% if dp_banner_title is not empty %} {{ dp_banner_title }} {% endif %}
        </h2>
        <h3>
          {% if dp_banner_sub_title is not empty %} {{ dp_banner_sub_title }} {% endif %}
        </h3>
      </div>
    </section>
  {% elseif dp_effect_type == 'withHeader' %}
    {% include '@unfpa_global/include/header.html.twig' %}
    <!-- hlf banner start -->
    <section class="hlf-banner">
      <div class="hero">
        <div class="hero__panel">
          <div class="hero__content">
            <p class="hero__label"></p>
            <h1 class="hero__heading">{{ dp_banner_title }}</h1>
            <a href="#makeDonation" class="hero__button" title="{{ "Scroll to donate now"|t }}">{{ "Donate now"|t }} <img src="/{{ module_path }}/images/arrow-right.svg" alt="{{ "Arrow Right"|t }}"></a>
            <a href="#readContent" class="hero__anchor" title="{{ "Scroll to read more"|t }}"><img src="/{{ module_path }}/images/arrow-down.svg" alt="{{ "Arrow Down"|t }}"></a>
          </div>
        </div>
        <div class="hero__image js-object-fit is-center-center">
          <img class="hero__crop" data-src="{{ dp_half_banner_desktop }}" srcset="{{ dp_half_banner_image_medium }},
               {{ dp_half_banner_desktop }}" sizes="(max-width: 640px) 720px, 1080px" alt="{{ dp_banner_title }}" data-was-processed="true">
        </div>
      </div>
    </section> <!-- hlf end-->
  {% else %}
    <div class="hero-image {{ dp_effect_type }}">
      <div class="hero-image__content">
        <h2>
          {% if dp_banner_title is not empty %} {{ dp_banner_title }} {% endif %}
        </h2>
        <p>
          {% if dp_banner_sub_title is not empty %} {{ dp_banner_sub_title }} {% endif %}
        </p>
        <a href="#makeDonation" class="btn secondary"> {{ 'Donate Now'|t }} </a>
      </div>
    </div>
    <!-- hero image end -->

    <div class="container-fluid {{ dp_effect_type }}-hero-image">
    {% endif %}

    <!-- Content 1 -->
    <section>
      <div class="container" id="readContent">
        <div class="content01">
          <h2>{{ node.title.value|render }}</h2>
          <div>{{ node.body.value|raw }}</div>
          <div class="btn-blk"><a class="donate-nowBtn" href="#makeDonation" title="Donate now">Donate now</a></div>
        </div>
      </div>
    </section>

    <!-- Content 2 -->
    <section>
      <div class="container" id="makeDonation">
        <div class="content02">
          <input id="alias" name="alias" type="hidden" value="{{ node_alias }}">
          <input id="curr_code" name="curr_code" type="hidden" value="{{ currency_code }}">
          <input id="currency_symbol" name="currency_symbol" type="hidden" value="{{ currency_symbol }}">

          <h2> {{ 'Make a secure donation'|t }} </h2>

          <div class="btn-blk02">
            <a id="OneTimePayClick" class="active"> {{ 'One-time'|t }} </a>
            <a id="MonthlyPayClick" class="heart"><i class="fa fa-heart"></i> {{'Monthly'|t }} </a>
          </div>

          <!-- One-time -->
          <div id="OneTimePay">
            <h3 class="otp-heading">
              {{ 'Choose an amount'|t }}
              <span class="otp-prefix">{{ 'in'|t }}</span>
              <span class="otp-currency">
                <button id="otp-currency-btn" class="currency-btn" label="{{ 'Show Currencies'|t }}" data-type="oneoff">
                  <span class="otp-currency-code">{{ currency_code }}</span>
                  <i class="fa fa-caret-right currency-icon"></i>
                </button>
              </span>
            </h3>
            <div class="amount-info">
              <ul class="amount clearfix nav nav-tabs">
                {% if onetime_price|length > 0 %} {% set i = 1 %} {% for key, value in onetime_price %} {% set active = (i == 3) ? 'active' : '' %}

                    <li class="{{ active }}">
                      <a class="onetime-price"  data-num="{{ i }}" data-symbol="{{ currency_symbol }}" data-type="0" data-price="{{ value.price|number_format(0, '.', '') }}" data-toggle="tab" href="#menu{{ i }}">
                        {{ currency_symbol }}<span class="current_amount">{{ value.price|number_format(0, '.', '') }}</span>
                      </a>
                    </li>

                    {% set i = i+1 %} {% endfor %}

                    <li>
                      <a class="onetime-price"  data-num="{{ i }}" data-symbol="{{ currency_symbol }}" data-type="1" data-price="0" data-toggle="tab" href="#menu{{ i }}">
                        {{ "Other"|t }}
                      </a>
                    </li>
                  {% endif %}
                </ul>

                <div class="amount-panel tab-content">
                  <span class="arrow" id="arrow"></span> {% if onetime_price|length > 0 %} {% set i = 1 %} {% for key, value in onetime_price %} {% set current = (i == 3) ? 'in active' : '' %}

                  <div id="menu{{ i }}" class="tab-pane fade {{ current }}">
                    <p> {{ currency_symbol ~ value.price|number_format(0, '.', '') }} {{ value.description }} </p>
                  </div>

                  {% set i = i+1 %} {% endfor %} {% endif %}
                    </div>
                  </div>
                </div>

                <!-- Monthly -->
                <div id="MonthlyPay" style="display: none;">
                  <h3 class="mp-heading">
                    {{ 'Choose a monthly amount'|t }}
                    <span class="mp-prefix">{{ 'in'|t }}</span>
                    <span class="mp-currency">
                      <button  id="mp-currency-btn" class="currency-btn" label="{{ 'Show Currencies'|t }}" data-type="oneoff">
                        <span class="mp-currency-code">{{ currency_code }}</span>
                        <i class="fa fa-caret-right currency-icon"></i>
                      </button>
                    </span>
                  </h3>

                  <div class="amount-info">
                    <ul class="amount clearfix nav nav-tabs">
                      {% if monthly_price|length > 0 %} {% set i = 6 %} {% for key, value in monthly_price %} {% set active = (i == 8) ? 'active' : '' %}


                          <li class="{{ active }}">
                            <a class="monthly-price"  data-num="{{ i }}" data-symbol="{{ currency_symbol }}" data-type="0" data-price="{{ value.price|number_format(0, '.', '') }}"  data-toggle="tab" href="#menu{{ i }}">{{ currency_symbol }}<span class="current_amount">{{ value.price|number_format(0, '.', '') }}</span></a>
                          </li>

                          {% set i = i+1 %} {% endfor %}

                          <li>
                            <a class="monthly-price"  data-num="{{ i }}" data-symbol="{{ currency_symbol }}" data-type="1" data-price="0" data-toggle="tab" href="#menu{{ i }}">
                              {{ "Other"|t }}
                            </a>
                          </li>

                        {% endif %}
                      </ul>

                      <div class="amount-panel tab-content">
                        <span class="arrow" id="arrow2"></span> {% if monthly_price|length > 0 %} {% set i = 6 %} {% for key, value in monthly_price %} {% set current = (i == 8) ? 'in active' : '' %}

                        <div id="menu{{ i }}" class="tab-pane fade {{ current }}">
                          <p> {{ currency_symbol ~ value.price|number_format(0, '.', '') }} {{ value.description }} </p>
                        </div>

                        {% set i = i+1 %} {% endfor %} {% endif %}
                          </div>
                        </div>
                      </div>

                      <div class="amount-panel amount02">
                        <div class="slct-amt-wrapper other-wrapper">
                          <div class="other-amout-field">
                            <div class="give-amount"> {{ 'Give'|t }} </div>
                            <div class="form-group">
                              <label class="sr-only" for="other_amount"> {{ 'Amount (in Swiss Francs)'|t }} </label>
                              <div class="input-group">
                                <div class="input-group-addon"> {{ currency_symbol }} </div>
                                <input type="text" onkeypress='validate(event)' min="0.00" id="other_amount" name="other_amount" class="form-control other-amt" placeholder="Amount">
                              </div>
                              <p id="otheramount-error-wrap" class="text-danger"></p>
                            </div>
                          </div>
                        </div>

                        <div class="slct-amt-wrapper amount_d">
                          <div class="give-amount">
                            {{ 'Give'|t }}
                            <span class="onetime_currency_code"> {{ currency_symbol }} </span>
                            <span class="heighlight onetime_values"></span>
                          </div>
                        </div>

                        {{ donate_page_form }}
                      </div>

                      <div class="btn-blk"><a class="primary-btn make-donation-btn"> {{ 'Make donation'|t }} </a></div>
                      <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="exampleCheck1" checked="checked" />
                        <label class="form-check-label" for="exampleCheck1">
                          {{ 'We will send you email updates about Friends of UNFPA and UNFPA’s work. Untick this box if you do not want to receive these updates.'|t }}
                        </label>
                      </div>
                      <div class="msg01">
                        <p>
                          <strong>
                            <i class="fa fa-spacing fa-lock" aria-hidden="true"></i>
                            {{ 'Your donation is processed securely'|t }}
                          </strong>
                        </p>

                        <p>
                          {{ 'Your donation is processed securely through Friends of UNFPA, a 501(c)(3) not-for-profit organization, to which contributions are tax-deductible to the fullest extent of the law. As the official support committee for UNFPA, the United Nations reproductive
            health and rights agency, every dollar you donate is used efficiently advancing UNFPA’s lifesaving work. Your privacy is important to us. Friends of UNFPA will not pass on your details to other organisations for marketing purposes.'|t }}
                        </p>
                      </div>
                    </div>
                  </div>
                </section>

                <!-- Content 3 -->
                <section>
                  <div class="container">
                    <div class="content03">
                      <h3> {{ 'Frequently Asked Questions'|t }} </h3>
                      <div class="panel-group" id="accordion">
                        <div class="panel panel-default">
                          <div class="panel-heading">
                            <h4 class="panel-title">
                              <a data-toggle="collapse" data-parent="#accordion" href="#collapse1" class="collapsed">
                                {{ 'How is my donation used by Friends of UNFPA?'|t }}
                              </a>
                            </h4>
                          </div>
                          <div id="collapse1" class="panel-collapse collapse">
                            <div class="panel-body">
                              <p>
                                {{ "As the official support committee for UNFPA, the United Nations reproductive health and rights agency, every dollar you give is used efficiently to support UNFPA’s lifesaving programs and to mobilize further funds for its critical work. Monies raised
                  directly benefit women and girls in need of services like emergency obstetric care, access to contraceptives allowing women to choose when and whether to concieve, care and support after experiencing gender-based violence, and protection
                  from child marriage and female genital mutilation. Only 6% of revenue raised by Friends of UNFPA is directed towards operating and management expeneses. Your support means that UNFPA can be there for the world's most vulnerable women
                  and populations, especially in response to COVID-19."|t }}
                              </p>
                            </div>
                          </div>
                        </div>
                        <div class="panel panel-default">
                          <div class="panel-heading">
                            <h4 class="panel-title">
                              <a data-toggle="collapse" data-parent="#accordion" href="#collapse2" class="collapsed"> {{ 'How is my donation secure?'|t }} </a>
                            </h4>
                          </div>
                          <div id="collapse2" class="panel-collapse collapse">
                            <div class="panel-body">
                              <p> {{ 'Friends of UNFPA uses appropriate industry-standard encryption for transmission of credit card information to help keep your information secure, accurate, current and complete.'|t }}
                              </p>
                              <p> {{ 'On this Stripe platform, all transactions are SSL protected. Stripe is a PCI Service Provider Level 1, which is the highest grade of payment processing security.'|t }}
                              </p>
                            </div>
                          </div>
                        </div>
                        <div class="panel panel-default">
                          <div class="panel-heading">
                            <h4 class="panel-title">
                              <a data-toggle="collapse" data-parent="#accordion" href="#collapse3" class="collapsed"> {{ 'How is my data used by UNFPA?'|t }} </a>
                            </h4>
                          </div>
                          <div id="collapse3" class="panel-collapse collapse">
                            <div class="panel-body">
                              <p>
                                {{ 'We do not trade, sell, lease, or rent email addresses to any outside organizations. If you choose to receive our emails, we will use this information to administer the e-mail lists and to track user interests. We may also use it to verify that you
                  are a Friends of UNFPA donor.'|t }}
                              </p>
                              <p>
                                {{ 'Your address and email information are used to process transactions, protect you against credit card fraud and contact you to provide you with a gift receipt for tax purposes.'|t }}
                              </p>
                            </div>
                          </div>
                        </div>
                        <div class="panel panel-default">
                          <div class="panel-heading">
                            <h4 class="panel-title">
                              <a data-toggle="collapse" data-parent="#accordion" href="#collapse4" class="collapsed"> {{ 'Is this donation tax deductible?'|t }} </a>
                            </h4>
                          </div>
                          <div id="collapse4" class="panel-collapse collapse">
                            <div class="panel-body">
                              <p>
                                {% trans %}Donations through UNFPA are not tax deductible. If you donate through our support committee in the United States, <a href="https://friendsofunfpa.org" target="_blank" rel="noopener">Friends of UNFPA</a>, your donation is tax-deductible. Do you need further assistance, get in touch with our team at <a href="mailto:giving@unfpa.org">giving@unfpa.org</a>.{% endtrans %}
                              </p>
                            </div>
                          </div>
                        </div>
                        <div class="panel panel-default">
                          <div class="panel-heading">
                            <h4 class="panel-title">
                              <a data-toggle="collapse" data-parent="#accordion" href="#collapse5" class="collapsed"> {{ 'Can I cancel my monthly donation?'|t }} </a>
                            </h4>
                          </div>
                          <div id="collapse5" class="panel-collapse collapse">
                            <div class="panel-body">
                              <p>
                                {{ 'Yes, you can cancel your donations at any time by emailing'|t }}
                                <br />
                                <a href="mailto:Donations@friendsofunfpa.org"> {{ 'Donations@friendsofunfpa.org' }} </a> {{'or calling'|t }}
                                <a href="tel:646-649-9110">646-649-9110</a>
                              </p>
                            </div>
                          </div>
                        </div>
                        <div class="panel panel-default">
                          <div class="panel-heading">
                            <h4 class="panel-title">
                              <a data-toggle="collapse" data-parent="#accordion" href="#collapse6" class="collapsed"> {{ 'When can I expect my receipt?'|t }} </a>
                            </h4>
                          </div>
                          <div id="collapse6" class="panel-collapse collapse">
                            <div class="panel-body">
                              <p>
                                {%trans%}Once your donation goes through successfully you will receive an automated email with your receipt. For further assistance, contact our team at <a href="mailto:giving@unfpa.org">giving@unfpa.org</a>.{% endtrans %}
                                <br />
                                <a href="mailto:Donations@friendsofunfpa.org"> {{ 'Donations@friendsofunfpa.org' }} </a> {{'or calling'|t }}
                                <a href="tel:646-649-9110">646-649-9110</a>
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>

                <!-- Help UNFPA mission -->
                <div class="container2 donation-help">
                  <h2> {{ 'With your donation you will help UNFPA in its mission to:'|t }} </h2>
                  <div class="row">
                    <div class="col-sm-4 col-md-4 col-lg-4">
                      <div class="blk">
                        <img src="/{{ module_path }}/images/birth.png" />
                        <p> {{ 'assure that no woman dies giving birth'|t }} </p>
                      </div>
                    </div>
                    <div class="col-sm-4 col-md-4 col-lg-4">
                      <div class="blk">
                        <img src="/{{ module_path }}/images/contraceptives.png" />
                        <p> {{ 'provide access to modern contraceptives sufficient to benefit 20 million women a year'|t }} </p>
                      </div>
                    </div>
                    <div class="col-sm-4 col-md-4 col-lg-4">
                      <div class="blk">
                        <img src="/{{ module_path }}/images/women.png" />
                        <p> {{ 'end violence against women, female genital mutilation, child marriage and teen pregnancies'|t }} </p>
                      </div>
                    </div>
                  </div>
                </div>

                {# Render Front Footer #} {% include '@unfpa_global/include/donate-footer.html.twig' %} {% if dp_effect_type != 'withoutHeader' %}
                </div>
              {% endif %} {% endblock %}


{# Currency Popup #}
<div class="popup-wrapper">
  <div class="row-backto">
    <div class="btn-close" id="btnClose">
      <i class="c-modal__close-icon fa fa-long-arrow-left" aria-hidden="true"></i>
    </div>
  </div>
  <div class="donate-currency-card">
    <form class="donate-currency-form" method="post">
      <div class="currency-input-wrapper">
        <label class="currency-input-label">{{ 'Select your currency'|t }}</label>
        <input type="text" id="currency-search-bar" class="currency-search-text" placeholder="{{ 'Search for currencies'|t }}" name="search-currency" />
        <i class="currency-field-icon fa fa-search" aria-hidden="true"></i>
      </div>
      <div></div>
      <ul id="currency-list">
        {% set currency_name = [] %}
        {% for country_info in country_details %}
          {% if country_info.name not in currency_name %}
            {% set currency_name = currency_name|merge([country_info.name]) %}
            <li class="currency-item" data-code="{{ country_info.currency }}">
              <button name="country_code" value="{{ country_info.code }}">
                {{ country_info.name ~ ' (' ~ country_info.symbol ~ ')' }}
                <span class="currency-symbol">{{ country_info.currency }}</span>
              </button>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      <input type="hidden" name="paymt_option" value=""/>
    </form>
  </div>
</div>
<div class="overley-white"></div>
