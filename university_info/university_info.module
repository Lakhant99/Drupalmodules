<?php
/**
 * HOOK_preprocess_html
 * @var 
 */
function university_info_preprocess_html(&$variables){
   $domain = \Drupal::service('domain.negotiator')->getActiveId();
   $config = \Drupal::config('university_info.config');
   if($config->get($domain) && $config->get($domain) > 0){
      $file = \Drupal\file\Entity\File::load($config->get($domain));
      if($file){
         $icon = file_url_transform_relative(file_create_url($file->getFileUri()));
         $icon = [
            '#tag' => 'link',
            '#attributes' => [
                'href' => $icon,
                'rel' => 'shortcut icon',
                'sizes' => '52x52'
            ],
          ];
          $variables['#attached']['html_head'][] = [
              $icon,
              'icon52x52'
          ];

      }
      
   }
}