<section class="margin-default home-map">
<header class="graph-header margin-small" for="mapChart">
  <div class="container">
    <div class="row end-xs middle-xs">
      <div class="graph-header__actions">
        <select name="" id="" class="select-year chart-select" data-filter="date">
          {% for year in homepage_map_data.date_dropdown %}
              <option value="{{ year }}">{{ year }}</option>
           {% endfor %}
        </select>
      </div>
    </div>
    <hr>
  </div>
</header>
<div class="container">
  <div class="row center-xs">
    <div class="col-md-12">
      <div id="mapChart" class="chart-container map-graph margin-small" data-type="mapTransactions" data-filters="[{column: 'date', value: {{ homepage_map_data.start_date }} }]"></div>
      <ul>
        <li id="aa-amount-hq-2010-15" style="display:none;"> {{ 'For 2010 to 2015, an additional amount of $@aa_amount was implemented in multi-country projects.'|t({'@aa_amount' : additional_amount_hq_all}) }}</li>
          <li id="aa-amount-hq">{{ 'For <span>@start_year</span>, an additional amount of $<span>@amount</span> was implemented by the UN headquarters, regional or sub-regional offices.'|t({'@start_year' : homepage_map_data.start_date, '@amount' : start_year_amount }) }}</li>
        </ul>
      </div>
    </div>
  </div>
</div>
</section>
<div class="row center-xs">
   <br><br><br><br>
   <a href="/dashboard" class="btn btn--default">{{ 'Dashboard'|t }}</a>

</div>
