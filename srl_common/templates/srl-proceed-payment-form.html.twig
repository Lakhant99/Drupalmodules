{{ attach_library('srl_payment/srl_payment') }}
{{ form.form_token }}
{{ form.form_build_id }}
{{ form.form_id }}
<div id="srl-payment-form-container">
  <div id="srl-proceed-payment-form-wrapper">
    <section class="bannerSection d-md-flex align-items-end">
      <div class="container">
        <div class="row">
          <div class="col-md-7 bannerText">
            <h1 class="font-weight-bold mt-3">Complete Your<br>Payment and Enroll</h1>
            <h3 class="mb-4 mb-md-5 mt-4">Pay up front or choose from a variety of financing options</h3>
            <div class=" col-md-6 button--custom">
              <div class="atten_pop">
                <a href="#online-payment-container" data-attr="pay-up-front" class="btnscrollpayment attention-btn btn">Pay Up Front</a>
              </div>
              <div class=" atten_poptwo">
                <a href="#online-payment-container" data-attr="finance-options" class="btnscrollpayment attention-btn btn">See Financing Options</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="whiteSection sectionPadding">
      <div class="container">
        <div class=" align-items-center">
          <h3 class="sectionTitle text-orange mb-3 mt-5">
            Choose the payment option that's right for you
          </h3>
        </div>
        <div class="row align-items-start">
          <div class="col-md-7 col-lg-7 col-xl-7">
            <p>
              Here at {{ form.site_name }}, we recognize the urgency of training the next generation of technology professionals. That's why we offer you a number of ways to pay for your bootcamp. Pay all at once or choose from three financing options, each with different rates and terms. We encourage you to compare each option to find the right one for you.
            </p>
            <p class="note mt-5">
              All financing options evaluate your eligibility through "soft" credit pulls that will not affect your credit score. A hard credit pull is only performed once the loan is accepted and funded.
            </p>
          </div>
          <div class="col-md-5 col-lg-5 col-xl-5">
            <img src="/themes/hilbert/images/srl_payment/side_img.jpg" class="img-fluid" alt="">
          </div>
        </div>
      </div>
    </section>
    <section id="online-payment-container" class="blueSection sectionPadding">
      <div class="container">
        <div class="row mt-5 text-center">
          <h3 class="section-title sectionTitle text--Blue mb-3 mt-5 text-center">Explore your options in minutes</h3>
          <div class="orange_line"></div>
        </div>
        <div class="row mt-5 justify-content-center">
          {% if form.upfront_payment %}
            <div class="{{ form.university_link_count }} paymentoptions mb-4 pay-up-front upfront_payment">
                <div class="pl-md-0 text-center view-buttonFeedback img-new">
                  <div class="item-detail">
                    <img src="/themes/hilbert/images/srl_payment/Untitled-first.png" class="img-fluid">
                    <h6 class="sectionSubHeading text-orange mt-4">Upfront Payment</h6>
                    {% if form._upfront_payment_text %}
                    {{ form._upfront_payment_text|raw }}
                     {% else %}

                    {{ form.upfront_payment_heading|raw }}
                    {% endif %}
                  </div>
                  <div class="form-submit-button">
                    {{ form.upfront_payment }}
                  </div>
                </div>
            </div>
          {% endif %}

          {% if form.upfront_payment_link_coursewise %}
            <div class="{{ form.university_link_count }} paymentoptions mb-4 pay-up-front upfront_payment">
                <div class="pl-md-0 text-center view-buttonFeedback img-new">
                  <div class="item-detail">
                    <img src="/themes/hilbert/images/srl_payment/Untitled-first.png" class="img-fluid">
                    <h6 class="sectionSubHeading text-orange mt-4">Upfront Payment</h6>
                    {% if form._upfront_payment_text %}
                    {{ form._upfront_payment_text|raw }}
                     {% else %}

                    {{ form.upfront_payment_heading|raw }}
                    {% endif %}

                  </div>
                  <div class="form-submit-button">
                    {{ form.upfront_payment_link_coursewise }}
                  </div>
                </div>
            </div>
          {% endif %}

          {# {% if form.link_response1 %}
            <div class="{{ form.university_link_count }}  paymentoptions mb-4 finance_meritize">
              <div class="pl-md-0 text-center view-buttonFeedback img-new">
                <div class="item-detail">
                  <img src="/themes/hilbert/images/srl_payment/Meritize-logo-removebg-preview.png" class="img-fluid">
                  <h6 class="sectionSubHeading text-orange mt-4">Other Financing Options are Available!</h6>
                  <p>
                    There are many options available that we are ready to discuss with you. Schedule call with our financing consultant to find the best solution for you.
                    </p>
                </div>
                <div class="form-submit-button">
                 <a class="btn btn-thanks btn-credit" target="_blank" href="{{ form.schedule_call_with_financing | raw }}">Schedule Call with Financing Consultant</a>

                </div>
              </div>
            </div>
          {% endif %} #}

          {% if form.finance_meritize %}
            <div class="{{ form.university_link_count }}  paymentoptions mb-4 finance_meritize">
              <div class="pl-md-0 text-center view-buttonFeedback img-new">
                <div class="item-detail">
                  <img src="/themes/hilbert/images/srl_payment/Meritize-logo-removebg-preview.png" class="img-fluid">
                  <h6 class="sectionSubHeading text-orange mt-4">Finance Through Meritize</h6>

                 {% if form.link_response1 %}
                    <p>
                    <i>Apply for a simple loan through our partner, Meritize.</i></br> Loans available between $1,000 USD and $13,000 USD
                  </p>
                     {% else %}

                    <p>
                    <i>Apply for a simple loan through our partner, Meritize.</i></br> Loans available between $1,000 USD and $10,500 USD
                  </p>
                    {% endif %}

                </div>
                <div class="form-submit-button">
                  {{ form.finance_meritize }}
                </div>
              </div>
            </div>
          {% endif %}


          {% if form.climb_credit_loan %}
            <div class="{{ form.university_link_count }}  paymentoptions mb-4 climb_credit_loan">
              <div class="pl-md-0 text-center view-buttonFeedback img-new">
                <div class="item-detail">
                  <img src="/themes/hilbert/images/srl_payment/icon_01.png" class="img-fluid">
                  <h6 class="sectionSubHeading text-orange mt-4">Apply for a Climb Loan</h6>
                   {% if form._climb_loan_text %}
                 {{ form._climb_loan_text|raw }}

                  {% else %}
                  {{ form.climb_loan_heading|raw }}
                  {% endif %}
                </div>
                <div class="form-submit-button">
                  {{ form.climb_credit_loan }}
                </div>
              </div>
            </div>
          {% endif %}
          {% if form.finance_climb_credit_loan %}
            <div class="{{ form.university_link_count }}  paymentoptions mb-4 finance_climb_credit_loan">
              <div class="pl-md-0 text-center view-buttonFeedback img-new">
                <div class="item-detail">
                  <img src="/themes/hilbert/images/srl_payment/icon_02.png" class="img-fluid">

                   {% if form._interest_financing_text %}
                   <h6 class="sectionSubHeading text-orange mt-4">Apply for 0% Interest Financing Through Climb</h6>


                   {{ form._interest_financing_text|raw }}

                    {% else %}
                    <h6 class="sectionSubHeading text-orange mt-4">Apply for 0% Interest Financing </h6>
                {{ form.interest_financing_heading|raw }}
                   {% endif %}
                </div>
                <div class="form-submit-button">
                  {{ form.finance_climb_credit_loan }}
                </div>
              </div>
            </div>
          {% endif %}

          {% if form.meritize_credit %}
            <div class="{{ form.university_link_count }}  paymentoptions mb-4 finance_meritize">
              <div class="pl-md-0 text-center view-buttonFeedback img-new">
                <div class="item-detail">
                  <img src="themes/hilbert/images/srl_payment/meritize_credit.png" class="img-fluid">
                  <h6 class="sectionSubHeading text-orange mt-4">Finance Through Meritize</h6>

                 {% if form._fieldset_meritize_credit_text %}
                     {{ form._fieldset_meritize_credit_text|raw }}
                    {% else %}
                      {{ form.meritize_credit_text_heading|raw }}
                  {% endif %}
                </div>
                <div class="form-submit-button">
                  {{ form.meritize_credit }}
                </div>
              </div>
            </div>
          {% endif %}

          {% if form.ascent_payment %}
            <div class="{{ form.university_link_count }}  paymentoptions mb-4 finance_meritize">
              <div class="pl-md-0 text-center view-buttonFeedback img-new">
                <div class="item-detail">
                  <img src="/themes/hilbert/images/srl_payment/ascent_payment_icon.png" class="img-fluid">
                  <h6 class="sectionSubHeading text-orange mt-4">Ascent Loan</h6>

                  {% if form._ascent_payment_text %}
                    {{ form._ascent_payment_text|raw }}
                    {% else %}
                      {{ form.ascent_payment_text_heading|raw }}
                  {% endif %}
                </div>
                <div class="form-submit-button">
                  {{ form.ascent_payment }}
                </div>
              </div>
            </div>
          {% endif %}
          
        </div>
        <div class="payment-proceed-loader d-none">
          <div class="text-center">
            <span><img src="/themes/hilbert/images/default_images/processing.gif" /></span>
            <span>Processing</span>
          </div>
          <p>You are being redirected to a preferred payment vendor, it might take a few seconds. Please do not refresh the page or close the browser and check your pop up blocker if you do not see the payment window appear.</br>Thank you!</p>
        </div>

     {% if form.link_response1 %}
        <div class="row mt-5">
          <div class="col-md-12 text-center schedule-call">
           {{ form.link_response1 }}
           </div>
        </div>
        <div class="row">
          <div class="col-md-12 text-center lastSection d-flex justify-content-center online-schedule-call">
             <a class="btn btn-thanks btn-credit" target="_blank" href="{{ form.schedule_call_with_financing | raw }}">Schedule Call with Financing Consultant</a>

          </div>
        </div>
         {% endif %}
      </div>
    </section>
    <section class="QuestionSection sectionPadding">
      <div class="container">
        <div class="row mt-5">
          <div class="col-md-12 text-center">
            <h3 class="sectionTitle dark-grey mb-3 text-center">Questions about any of these options? <span>Call us toll-free: {{ form.site_phone | raw }}</span></h3>
            <p>By clicking any of the "Select" buttons and submitting a payment, you agree to the Climb or Meritize Privacy Policy and {{ form.site_name }} Payment Terms & Conditions, Privacy Policy, Enrollment Agreement and E-Sign Consent.</p>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12 text-center lastSection d-flex justify-content-center ">
            <a class="chat-open btn btn-chat btn-theme m-auto mt-3" target="_blank" href="{{ form.chatbot_link | raw }}"> Let's Talk If You Have More Questions</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
