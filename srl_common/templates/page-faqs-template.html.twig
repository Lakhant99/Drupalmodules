<section class="faq-container">
   <div class="row">
      {% if page_content.domain == 'mercy_edu' %}
         <div id="accordion-faq">
            {% for item in page_content.faqs %}
            <div class="card">
               <div class="card-header qa" id="headingOne">
                  <button class="btn btn-link fa fa-plus collapsed" data-toggle="collapse" data-target="#collapse{{ loop.index }}" aria-expanded="true" aria-controls="collapseOne"></button>
                  <button class="btn btn-link" data-toggle="collapse" data-target="#collapse{{ loop.index }}" aria-expanded="true" aria-controls="collapseOne">
                     {{ item.title|raw }}
                  </button>
               </div>
               <div id="collapse{{ loop.index }}" class="collapse" aria-labelledby="headingOne" data-parent="#accordion-faq">
                  <div class="card-body">{{ item.answer|raw }}</div>
               </div>
            </div>
            {% endfor %}
         </div>
      {% else %}
         {{ page_content.faq_left|raw }}
         {{ page_content.faq_right|raw }}
      {% endif %}
   </div>
</section>