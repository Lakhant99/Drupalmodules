      $form['elements']['basic_information']['phone']['#suffix'] = '</div>';
      // if($domain == 'srl_qc_niit_mts_com' || $domain == 'srl_adelphi_qc_niit_mts_com' || $domain == 'adelphi_landing_university' || $domain == 'srl_pointpark_qc_niit_mts_com' || $domain == 'point_park_university' || $domain == 'stackroute_suffolk_university'){
        $form['elements']['program_funding']['how_do_you_plan_on_funding_your_bootcamp']['#field_prefix'] = '<span class="field-prefix">Those hello Students Who Chose to Pay in full up-front will receive a $3000 Discount!</span>';
        // }

      if(isset($course_id)){
        if (array_key_exists($course_id,$options)){
          $form['elements']['program_fit']['program_interest']['#default_value'] = $course_id;
          $form['elements']['program_fit']['program_interest']['#attributes']['disabled'] = 'disabled';
        }
      }
      $coursereference_id = $form_state->getValue('program_interest');
      $discount_fee_amount = getdiscountfee($domain,$coursereference_id);
      $discount_fee_amount= number_format($discount_fee_amount);
      $suffix_text= '<span class="field-prefix">'."Those Students Who Chose to Pay in full up-front will receive a"." $"."$discount_fee_amount"." USD Discount!".'</span>' ;
