/*
* @implement GET TEST MASTER
* Get Course program Test Master info by course code 
*/
function getaptitudetestInfo($courseCode){
  $query = db_select('node__field_course_code','course'); // our programs
  $query->fields('AT',array('field_aptitudetest_target_id','entity_id'));
  $query->fields('UD',array('field_university_domain_target_id'));
  $query->leftjoin('node__field_aptitudetest','AT','course.entity_id=AT.entity_id');
  $query->leftjoin('node__field_course_code_reference','CCR','course.entity_id=field_course_code_reference_target_id');
  $query->leftjoin('node__field_university_domain','UD','CCR.entity_id=UD.entity_id');
  $query->condition('course.field_course_code_value',$courseCode,'=');
  $result = $query->execute()->fetchAll();
  
  return $result[0];
}
/**Get batch date */
function getCourseBatchDate($course_id,$domain){
  $current_date = \Drupal::time()->getRequestTime();
  $batch_start_date = '';
  $results = \Drupal::entityQuery('node')
    ->condition('type', 'course_university_mapping')
    ->condition('field_domain_access.target_id', $domain)
    ->condition('field_course_code_reference.target_id', $course_id)
    ->execute();
    foreach($results as $value){
      $course_map = $value;
    }
    if($course_map){
      $node_storage = \Drupal::entityTypeManager()->getStorage('node');
      $node = $node_storage->load($course_map);
  
        $close_day = $node->get('field_registration_close_day')->getValue()[0]['value'];
        $next_current_date = strtotime('+'.$close_day, $current_date);
        $batch_dates = $node->get('field_course_batch_start_date')->getValue();
        if(count($batch_dates) > 0){
            $date_timestamp = [];
            foreach($batch_dates as $batch_date){
              $get_date = strtotime($batch_date['value']);
              if($get_date >= $next_current_date){
                  $date_timestamp[] = $get_date;
              }
            }
            sort($date_timestamp);
            foreach($date_timestamp as $batch_date){
              if($batch_date >= $next_current_date){
                  $batch_start[] = $batch_date;
              }
            }
            if(count($batch_start) > 0){
              $batch_start_date = date('Y-m-d',$batch_start[0]);
            }
        }
    }
    return $batch_start_date;
}
/*
 *  @implement 
 * save webform assessment Application fourm information.
*/
function insertApplicationInfo($records){ 
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $course_node = \Drupal::entityTypeManager()->getStorage('node')->load($records['program_interest']);
  $query = db_select('node__field_course_code','course');
      $query->fields('course',array('field_course_code_value'));
      $query->condition('course.entity_id',$records['program_interest'],'=');
      $result = $query->execute()->fetchCol();
      $records['course_code'] = $result[0];
  $test_master = getaptitudetestInfo($records['course_code']);
  $records['course_id'] = $records['program_interest'];
  
  $phone_number = merge_PhoneWithCountry($records['phone'],$records['country']);
  

  $records['transaction_id'] = $phone_number.'_'.\Drupal::time()->getRequestTime();
  if(isset($course_node->field_aptitudetest->target_id)){
    $test_master_info = Term::load($course_node->field_aptitudetest->target_id);
    
    $records['bu_code'] = $test_master_info->get('field_bucode')->getValue()[0]['value'];
    $records['orgid'] = $test_master_info->get('field_orgid')->getValue()[0]['value'];
    $records['source_code'] = $test_master_info->get('field_sourcecode')->getValue()[0]['value'];
    $records['test_code'] = $test_master_info->get('field_testcode')->getValue()[0]['value'];
    $records['test_type'] = $test_master_info->get('field_testtype')->getValue()[0]['value'];
    $records['passing_percentage'] = $test_master_info->get('field_passing_percentage')->getValue()[0]['value'];
  }
  if(isset($test_master->field_university_domain_target_id)){
    $un_domain = Term::load($test_master->field_university_domain_target_id);
    $records['country_code'] = $un_domain->get('field_country_code')->getValue()[0]['value'];
    $records['center_code'] = $un_domain->get('field_center_code')->getValue()[0]['value'];
    $records['university_code'] = $un_domain->get('field_university_code')->getValue()[0]['value'];
  }
  $batch_start_date = getCourseBatchDate($records['course_id'],$domain);
  $connection = \Drupal::service('database');
    $connection->insert('srl_candidate_test_details')
    ->fields(['transaction_id','course_id', 'name', 'email_id','mobile_no','course_code','university_code','country_code',
              'center_code','orgid','bu_code','source_code','test_code','test_type','access_permission','json_response','passing_percentage','result','domain_id', 'batch_start_date','form_version',
    ])
    ->values([
      'transaction_id' => $records['transaction_id'],
      'course_id' => $records['course_id'],
      'name' => $records['full_name'].' '.$records['last_name'],
      'email_id' => $records['email'],
      'mobile_no' => $phone_number,
      'course_code' => $records['course_code'],
      'university_code' => $records['university_code'],
      'country_code' => $records['country_code'],
      'center_code' => $records['center_code'],
      'orgid' => $records['orgid'],
      'bu_code' => $records['bu_code'],
      'source_code' => $records['source_code'],
      'test_code' => $records['test_code'],
      'test_type' => $records['test_type'],
      'access_permission' => 1,
      'json_response' => addslashes(json_encode($records)),
      'passing_percentage' => $records['passing_percentage'],
      'result' => 'skiped',
      'domain_id' => $domain,
      'batch_start_date' => $batch_start_date,
      'steps_level' => 1,
      'form_version' => 2,
    ])
    ->execute();
    $session = \Drupal::request()->getSession();
    $session->set('transaction_id', $records['transaction_id']);
    return $records['transaction_id'];
}
/** @implement 
 * Update assessment start date time info 
 * */
function insertStartDatetime($transaction_id){
  $connection = \Drupal::service('database');
  $start_time = \Drupal::time()->getRequestTime();
  $query = $connection->update('srl_candidate_test_details')
    ->fields([
      'assessment_started_on' => $start_time
    ])
    ->condition('transaction_id', $transaction_id, '=')
    ->execute();
}
/**@implements
 * Get assessment info and send to assessment system.
 */
function getAssessmentUserRecord($transaction_id){
  $query = db_select('srl_candidate_test_details','records');
    $query->fields('records',array('transaction_id','course_id','name', 'email_id','mobile_no','course_code','university_code','country_code','center_code','orgid','bu_code','batch_start_date','source_code','json_response','payment_status'));
    $query->condition('records.transaction_id',$transaction_id);
    $field_values=$query->execute()->fetchAll(); 
  return $field_values[0];
}
