function srl_common_form_alter(&$form, &$form_state, $form_id){
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  if(isset($form['elements']['phone_code'])){
    $form['elements']['phone_code']['#options'] = getCountryCode();
  }
  if(isset($form['elements']['phone']['phone_code'])){
    $form['elements']['phone']['phone_code']['#options'] = getCountryCode();
    $form['elements']['phone']['phone_code']['#default_value'] = 1;
  }
  if(isset($form['elements']['i_agree_to_revived_other_communication_from_stackroute_learning_'])){
    $site_name = \Drupal::config('system.site')->get('name');
    $site_name_prefix = '';
    $site_name_suffix = '';
    if( $domain == 'srl_qc_niit_mts_com'){
      $site_name_suffix = ' Office of Professional & Continuing Education (OPCE)';
    }elseif($domain == 'mercy_edu' || $domain == 'stackroute_mercy_college'){
      $site_name_prefix = 'CERTIFi by';
    }
    elseif($domain == 'stackroute_suffolk_university'){
      $site_name_suffix = 'Center for Continuing and Professional Education';
    }
    $label_name = 'I agree to receive other communications from '.$site_name_prefix.' '.$site_name.' '.$site_name_suffix;
    
    $description = '<p>By requesting info, I am authorizing '.$site_name_prefix.' '.$site_name.' '.$site_name_suffix.' to contact me using the phone number and email address provided above, by auto-dialer or via text, about its programs of study. Authorization is not required to apply or enroll. As an alternative to granting this authorization, I can get information or apply by calling the '.$site_name_prefix.' '.$site_name.' '.$site_name_suffix.' directly.</p>';
    
    $form['elements']['i_agree_to_revived_other_communication_from_stackroute_learning_']['#title'] = $label_name;	
    $form['elements']['i_agree_to_revived_other_communication_from_stackroute_learning_']['#description']['#markup'] = $description;
  }
  
  if( $form_id == 'taxonomy_term_university_form'){
    $properties = [
       'vid' => 'university_policy',
    ];
    $terms = \Drupal::entityManager()->getStorage('taxonomy_term')->loadByProperties($properties);
    foreach($terms as $key => $values){
       $type = $values->get('field_policy_type')->getValue()[0]['value'];
       if($type == 'EA'){
          $enrollment['_none'] = '- Select a value -';
          $enrollment[$key] = $values->getName();
          $form['field_enrollment_agreement']['widget']['#options'] = $enrollment;
       }
       if($type == 'TOU'){
          $term_of_use['_none'] = '- Select a value -';
          $term_of_use[$key] = $values->getName();
          $form['field_term_of_use']['widget']['#options'] = $term_of_use;
       }
    }
  }
  if($form['#id'] == 'views-exposed-form-order-summary-page-1'){
    
    $batch_date = db_select('node__field_course_batch_start_date','B_date');
    $batch_date->fields('B_date',['field_course_batch_start_date_value']);
    $batch_date->distinct();
    $dates =  $batch_date->execute()->fetchAll();
    foreach($dates as $key => $value){
      $timestamp[] = strtotime($value->field_course_batch_start_date_value);
      
    }
    sort($timestamp);
    $batch_start[''] = 'All';
    foreach($timestamp as $time){
      $batch_start[date('Y-m-d',$time)] = date('Y-m-d',$time);
    }
    $form['cohort_date']['#type'] = 'select';
    $form['cohort_date']['#options'] = $batch_start;
    $form['cohort_date']['#default_value'] = 'All';
    $form['cohort_date']['#size'] = 1;

    $form['term_of_use']['#type'] = 'select';
    $form['term_of_use']['#options'] = ['' => 'All',1 => 'Yes',0 => 'No'];
    $form['term_of_use']['#default_value'] = 'All';
    $form['term_of_use']['#size'] = 1;

    $form['enrollment_agreement']['#type'] = 'select';
    $form['enrollment_agreement']['#options'] = ['' => 'All',1 => 'Yes',0 => 'No'];
    $form['enrollment_agreement']['#default_value'] = 'All';
    $form['enrollment_agreement']['#size'] = 1;

    $domain_list = \Drupal::service('domain.loader')->loadOptionsList();
    $options[''] = 'All';
    foreach($domain_list as $key => $value){
      $options[$key] = $value;
    }
    $form['university']['#type'] = 'select';
    $form['university']['#options'] = $options;
    $form['university']['#default_value'] = 'All';
    $form['university']['#size'] = 1;
  }
}
