function createTerm(){
  $country = country_code();
  foreach($country as $key => $category){
    // kint($category,$key);
    $term = \Drupal::entityManager()->getStorage('taxonomy_term')->loadByProperties(['name' => trim($category)]);
    $term = reset($term);
    $term_id = $term ? FALSE : TRUE;
    if($term_id){
      // $term = Term::load($_tid);
      // $term->field_country_code->setValue($key);
      // $term->Save();
      $term = Term::create(array(
        'name' => trim($category),
        'field_country_code' => $key,
        'vid' => 'country_code',
      ))->save();
    }

  }
}
function getCountryCode(){
  $query = \Drupal::entityQuery('taxonomy_term');
  $query->condition('vid', "country_code");
  $query->sort('name','ASC');
  $tids = $query->execute();
  $terms = \Drupal\taxonomy\Entity\Term::loadMultiple($tids);
  foreach ($terms as $term) {
      $options[$term->get('field_country_code')->value] = $term->getName();
      
  }
  return $options;
}

/** set program intrested options  */
function setUniversityProgramsOptions($domain){
  $course_id = \Drupal::request()->query->get('course');
  $query = db_select('node_field_data','course');
  $query->leftjoin('node__field_domain_access','domain','course.nid=domain.entity_id');
  $query->leftjoin('node__field_course_code_reference','ccr','course.nid=ccr.entity_id');
  $query->leftjoin('node__field_map_in_hubspot','mh','course.nid=mh.entity_id');
  $query->fields('ccr',array('field_course_code_reference_target_id'));
  $query->condition('course.type','course_university_mapping');
  $query->condition('course.status',1);
  $query->condition('mh.field_map_in_hubspot_value',1);
  $query->condition('domain.field_domain_access_target_id',$domain);
  $records = $query->execute();
  while($result = $records->fetchAssoc()){
    if($result['field_course_code_reference_target_id']){
      $nids[$result['field_course_code_reference_target_id']] = $result['field_course_code_reference_target_id'];
    }
  }
  $query = db_select('node_field_data','course');
  $query->fields('course',array('nid','title'));
  $query->condition('course.nid',$nids,'IN');
  $query->condition('course.status',1);
  $records = $query->execute();
  $options = [];
  while($result = $records->fetchAssoc()){
    $options[$result['nid']] = $result['title'];
  }
  return $options;
}

/** set landing program intrested options  */

function setUniversityLandingProgramsOptions($domain, $page_template){
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $query = db_select('node_field_data','course');
  $query->leftjoin('node__field_domain_access','domain','course.nid=domain.entity_id');
  $query->leftjoin('node__field_microsite_course_reference','msp','course.nid=msp.entity_id');
  $query->leftjoin('node__field_page_layout','pl','course.nid=pl.entity_id');
  $query->fields('msp',array('field_microsite_course_reference_target_id'));
  $query->condition('course.type','course_landing_page');
  $query->condition('course.status',1);
  $query->condition('pl.field_page_layout_value',$page_template);
  $query->condition('domain.field_domain_access_target_id',$domain);
  $records = $query->execute();
  while($result = $records->fetchAssoc()){
    if($result['field_microsite_course_reference_target_id']){
      $nids[$result['field_microsite_course_reference_target_id']] = $result['field_microsite_course_reference_target_id'];
    }
  }

  $query = db_select('node_field_data','course');
  $query->fields('course',array('nid','title'));
  $query->condition('course.nid',$nids,'IN');
  $query->condition('course.status',1);
  $records = $query->execute();
  $options = [];
  while($result = $records->fetchAssoc()){
    $options[$result['nid']] = $result['title'];
  }
  return $options;
}


/**
 * Webform submission handler for the 'goto' action.
 *
 * @param array $form
 *   An associative array containing the structure of the form.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 */
function srl_common_webform_submission_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $form['#cache'] = ['max-age' => 0];
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  /**new application form */
  if($form_id == 'webform_submission_new_application_form_add_form'){
    $session = \Drupal::request()->getSession();
    $session->remove('transaction_id');
    {
      $course_id = \Drupal::request()->query->get('course');
      $options = setUniversityProgramsOptions($domain);
      
      $form['elements']['program_fit']['program_interest']['#options'] = $options;

      // $test = $form['elements']['program_fit']['program_interest']['widget'][0]['value']['#default_value'];
      // $mytset = $form['elements']['program_fit']['program_interest']['widget'][0]['target_id']["#value"];
      
      
      // $form['#after_build'][] = 'set_keywords_after_build';

      // $key = $form_state->input["program_interest"];
      // $val = $form['elements']['program_fit']['program_interest']['#options'] [$key];





