/**preprocess hook menu
 * alter main menu
 */
function getProductPageUrl(){
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $path_alias = [];
  $query = db_select('node_field_data','node');
  $query->leftjoin('node__field_course_code_reference','program','node.nid=program.entity_id');
  $query->leftjoin('node__field_domain_access','domain','node.nid=domain.entity_id');
  $query->fields('program',array('field_course_code_reference_target_id'));
  $query->condition('node.status',1);
  $query->condition('node.type','course_university_mapping');
  $records = $query->condition('domain.field_domain_access_target_id',$domain)->execute();
  while($result = $records->fetchAssoc()){
      $nid = $result['field_course_code_reference_target_id'];
      $alias = \Drupal::service('path.alias_manager')->getAliasByPath('/node/' . $nid);
      $path_alias[$nid] = $alias;
      
    }
  return $path_alias;

}
function getdiscountfee($domain,$coursereference_id){
  $query = db_select('node__field_discount_fees', 'disfee');
  $query->leftjoin('node__field_course_code_reference','cr','disfee.entity_id=cr.entity_id');
  $query->leftjoin('node__field_domain_access','domain','cr.entity_id=domain.entity_id');
  $query->fields('disfee',array('field_discount_fees_value'));
  $query->condition('disfee.bundle','course_university_mapping');
  $query->condition('cr.field_course_code_reference_target_id',$coursereference_id);
  $query->condition('domain.field_domain_access_target_id',$domain);
  $field_values=$query->execute()->fetchAll();
  if($field_values[0]){
      return $field_values[0]->field_discount_fees_value;
  }
  
}
function srl_common_user_login($account) {
  $roles = $account->getRoles($exclude_locked_roles = false);
  if(in_array('marketing_management',$roles)){
    $response = new Symfony\Component\HttpFoundation\RedirectResponse('/download-policy-pdf');
    $response->send();
    return;
  }
}
function srl_common_preprocess_menu(&$variables, $hook) {
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  if($variables['menu_name'] == 'main-menu'){
    $items = $variables['items'];
    foreach ($items as $key => &$item) {
      if($item['url']->isExternal()){
        if($item['url']->getUri() == 'https://www.hilbert.edu/'){
          if( $domain == 'srl_hilbert_qc_niit_mts_com' ||  $domain == 'srl_qc2_niit_mts_com'){
            // \Drupal::logger('menu alter')->notice('echo save external '.print_r($item['url']->getUri(),TRUE));
          }else{
            unset($variables['items'][$key]);
          }
        }
      }
    }
  }
}
