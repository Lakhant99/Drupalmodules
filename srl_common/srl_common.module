/** view pre render */
function srl_common_views_pre_render(\Drupal\views\ViewExecutable $view) {
  if ($view->id() == "order_summary" && $view->current_display == 'page_1') {
     $results = $view->result;
     $domain_list = \Drupal::service('domain.loader')->loadOptionsList();
     foreach($results as $key => $value){
       
       $mobile_no = $value->payeezy_payment_details_mobile_no;
       $str = explode('-',$mobile_no);
       $mobile_no = '+'.(int) filter_var($str[0], FILTER_SANITIZE_NUMBER_INT).'-'.$str[1];
       $value->payeezy_payment_details_mobile_no = $mobile_no;
       
       $domain_id = $value->payeezy_payment_details_university;
       $value->payeezy_payment_details_university = $domain_list[$domain_id];
       
       $enrollment = $value->payeezy_payment_details_enrollment_agreement_pdf;
       $term_of_use = $value->payeezy_payment_details_term_of_use_pdf;
        if($enrollment == 'rejected' || $enrollment == ''){
          $value->payeezy_payment_details_enrollment_agreement_pdf = NULL;
        }
        if($term_of_use == 'rejected' || $term_of_use == ''){
           $value->payeezy_payment_details_term_of_use_pdf = NULL;
        }
     }
  }
}
function checkAccessRecord($transaction_id){
  $query = db_select('srl_candidate_test_details','records');
    $query->fields('records',array('transaction_id'));
    $query->condition('records.transaction_id',$transaction_id);
    $field_values=$query->execute()->fetchCol();
    
    return $field_values[0];
}

function getCourseVideoLink($entity_id){
  $connection = Database::getConnection();
  $sth = $connection->select('node__field_video_media', 'vm')
        ->fields('vm', array('field_video_media_value'))
        ->condition('vm.entity_id',$entity_id);
      $data = $sth->execute()->fetchAll();
      if(isset($data[0]->field_video_media_value) && strlen($data[0]->field_video_media_value) > 1){
        $media_url = $data[0]->field_video_media_value;
        if(strpos($media_url, 'youtube') !== false){
          preg_match('/^https?:\/\/(www\.)?((?!.*list=)youtube\.com\/watch\?.*v=|youtu\.be\/)(?<id>[0-9A-Za-z_-]*)/', $media_url, $matches);
          $youtube_src = 'https://www.youtube.com/embed/'.$matches['id'].'?enablejsapi=1&autoplay=1&rel=0';
          $youtube_url[] = isset($matches['id']) ? 'youtube' : FALSE;
          $youtube_url[] = isset($matches['id']) ? $youtube_src : FALSE;
          return  $youtube_url;
        } elseif(strpos($media_url, 'vimeo') !== false){
            
          $url = (int) substr(parse_url($data[0]->field_video_media_value, PHP_URL_PATH), 1); 
          $url_src = 'https://player.vimeo.com/video/'.$url.'?rel=0&amp;hd=1&amp;autoplay=true&amp;loop=0';
          $vimeo_url[] = isset($url) ? 'vimeo' : FALSE;
          $vimeo_url[] = isset($url) ? $url_src : FALSE;
          return $vimeo_url;
        }

      }
      
} 
function getCurrentDate($format = NULL){
  $current_time = \Drupal::time()->getCurrentTime();
  if($format){
    $current_date = strtotime(date($format,$current_time));
  }else{
    $current_date = strtotime(date('Y-m-d',$current_time));
  }

  return $current_date;
}
function phoneNumberValidation($phone_number = NULL){
  $validate = FALSE;
  if($phone_number){
    $pattern = '/^[0-9\-\(\)\/\+\s]{10,17}$/';
    $phoneNumbers = trim($phone_number);

    preg_match($pattern, $phoneNumbers, $matches);
    if($matches[0]){
      $int_number = filter_var($matches[0], FILTER_SANITIZE_NUMBER_INT);
      if(strlen($int_number) < 10 || strlen($int_number) > 12){
        $validate = FALSE;
          
      }else{
          $validate = TRUE;
      }
    }else{
      $validate = FALSE;
        
    }
  }
  return $validate;
}
function regexValidation($pattern,$string){
  $validate = FALSE;
  $string = trim($string);

  preg_match($pattern, $string, $matches);
  
  if($matches[0]){
    $validate = TRUE;
  }
  return $validate;
}
function getStepsInfo($email, $phone_number, $step){
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $query = db_select('stackroute_webform_tempdata','records');
    $query->fields('records',['transaction_id']);
    $query->condition('records.email_id',$email);
    $query->condition('records.mobile_no',$phone_number);
    $query->condition('records.domain_id',$domain);
    $query->condition('records.step',$step);
    $field_values=$query->execute()->fetchAll();
  return $field_values[0];
}

function insertWebformTempData($data){
    $phone_number = str_replace('+','',$data['phone']);
    $phone_number = str_replace('-','',$phone_number);
    $phone_number = str_replace(' ','',$phone_number);
    $phone_number = str_replace('(','',$phone_number);
    $phone_number = str_replace(')','',$phone_number);
    // $phone_number = (int) filter_var($data['country'], FILTER_SANITIZE_NUMBER_INT).'-'.$phone_number;
    $phone_number = trim($data['country']).'-'.$phone_number;

    $temp_transaction_id = getStepsInfo($data['email'], $phone_number, $data['step']);
    if(!$temp_transaction_id){
      $transaction_id = getStepsInfo($data['email'], $phone_number, 'user_info');
      $temp_transaction_id = $transaction_id->transaction_id ? $transaction_id->transaction_id : $phone_number.'_'.\Drupal::time()->getRequestTime();
      insert_webform_data($data,$temp_transaction_id);

    }else{
      if($data['step'] == 'our_overall_career_outlook'){
        $connection = \Drupal::service('database');
        $connection->delete('stackroute_webform_tempdata')
          ->condition('transaction_id', $temp_transaction_id->transaction_id)
          ->execute();
      }else{
        update_webform_data($data,$temp_transaction_id->transaction_id);
      }
    }
}
function insert_webform_data($data,$temp_transaction_id){
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $phone_number = str_replace('+','',$data['phone']);
  $phone_number = str_replace('-','',$phone_number);
  $phone_number = str_replace(' ','',$phone_number);
  $phone_number = str_replace('(','',$phone_number);
  $phone_number = str_replace(')','',$phone_number);
  $connection = \Drupal::service('database');
  $connection->insert('stackroute_webform_tempdata')
      ->fields(['transaction_id','email_id', 'mobile_no', 'step','step_json_data','domain_id','form_version'])
      ->values([
        'transaction_id' => $temp_transaction_id,
        'email_id' => $data['email'],
        'mobile_no' => trim($data['country']).'-'.$phone_number,
        'step' => $data['step'],
        'step_json_data' => json_encode($data),
        'domain_id' => $domain,
        'program_interest' => $data['program_interest'],
        'form_version' => 2,
      ])
      ->execute();
}
function update_webform_data($data,$temp_transaction_id){
  $connection = \Drupal::service('database');
  $phone_number = str_replace('+','',$data['phone']);
  $phone_number = str_replace('-','',$phone_number);
  $phone_number = str_replace(' ','',$phone_number);
  $phone_number = str_replace('(','',$phone_number);
  $phone_number = str_replace(')','',$phone_number);

  $connection->update('stackroute_webform_tempdata')
    ->fields([
      'email_id' => $data['email'],
      'mobile_no' => trim($data['country']).'-'.$phone_number,
      'step_json_data' => json_encode($data),
      'program_interest' => $data['program_interest'],
    ])
    ->condition('transaction_id', $temp_transaction_id, '=')
    ->condition('step', $data['step'], '=')
    ->execute();
}
function resumeApplicationForm(){
  $data = NULL;
  $session = \Drupal::request()->getSession();
  $temp_transaction_id = $session->get('temp_transaction_id_resume');

  if($temp_transaction_id){
    $query = db_select('stackroute_webform_tempdata','records');
    $query->fields('records',['step','step_json_data']);
    $query->condition('records.transaction_id',$temp_transaction_id);
    $query->orderby('records.id','ASC');
  
    $step_data = $query->execute();
    while($data_values = $step_data->fetchAssoc()){
      $data[$data_values['step']] = $data_values['step_json_data'];
    } 
  }
  return $data;
}
function setApplicationProcessSteps($data){
  $connection = \Drupal::service('database');
  $application = db_select('srl_candidate_test_details', 'detail');
    $application->fields('detail', ['steps_level']);
    $application->condition('detail.transaction_id',$data['transaction_id']);
    $assessment = $application->execute()->fetchCol();
    if($assessment[0] == 1){
      $query = $connection->update('srl_candidate_test_details')
        ->fields([
          'steps_level' => 2
        ])
        ->condition('transaction_id',$data['transaction_id'], '=')
        ->execute();

    }elseif($assessment[0] == 2){
      $query = $connection->update('srl_candidate_test_details')
        ->fields([
          'steps_level' => 3
        ])
        ->condition('transaction_id',$data['transaction_id'], '=')
        ->execute();
    }else{
      $query = $connection->update('srl_candidate_test_details')
        ->fields([
          'steps_level' => 2
        ])
        ->condition('transaction_id',$data['transaction_id'], '=')
        ->execute();
    }
}
function deleteWebformTempData($values){
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $phone_number = str_replace('+','',$values['phone']);
  $phone_number = str_replace('-','',$phone_number);
  $phone_number = str_replace(' ','',$phone_number);
  $phone_number = str_replace('(','',$phone_number);
  $phone_number = str_replace(')','',$phone_number);
  $phone_number = trim($values['country']).'-'.$phone_number;

  $connection = \Drupal::service('database');
      $connection->delete('stackroute_webform_tempdata')
      ->condition('email_id', $values['email'])
      ->condition('mobile_no',$phone_number)
      ->condition('domain_id',$domain)
      ->execute();
}
function resetResumeApplicationSteps($data){
  $connection = \Drupal::service('database');
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $phone_number = str_replace('+','',$data['phone']);
  $phone_number = str_replace('-','',$phone_number);
  $phone_number = str_replace(' ','',$phone_number);
  $phone_number = str_replace('(','',$phone_number);
  $phone_number = str_replace(')','',$phone_number);
  $phone_number = trim($data['country']).'-'.$phone_number;

  $connection->update('srl_candidate_test_details')
    ->fields([
        'steps_level' => 0,
    ])
    ->condition('email_id',$data['email'])
    ->condition('mobile_no', $phone_number)
    ->condition('domain_id',$domain)
    ->execute();
}
function getNextBatchDate($course_id,$domain){
  $next_date = '';
  $current_date = \Drupal::time()->getRequestTime();
  $results = \Drupal::entityQuery('node')
      ->condition('type', 'course_university_mapping')
      ->condition('field_domain_access.target_id', $domain)
      ->condition('field_course_code_reference.target_id', $course_id)
      ->execute();
      if($results){
        $course_batch= array_values($results);
        $course = \Drupal::entityTypeManager()->getStorage('node')->load($course_batch[0]);

        $batch_dates = $course->get('field_course_batch_start_date')->getValue();
        $close_day = $course->get('field_registration_close_day')->getValue()[0]['value'];
        $next_current_date = strtotime('+'.$close_day, $current_date); // 13th

        $date_timestamp = [];
        foreach($batch_dates as $batch_date){
          $get_date = strtotime($batch_date['value']);
          $get_date = date('d M Y',$get_date).' 23:59:59';
          $get_date = strtotime($get_date);
          if($get_date >= $next_current_date){
              $date_timestamp[] = $get_date;
          }
        }
        sort($date_timestamp);
        $next_date = date('F d',$date_timestamp[0]).'<span>'.date('S',$date_timestamp[0]).'</span> '.date('Y',$date_timestamp[0]);
      }
      return $next_date; 
}
function getUniversityTOS($domain){
  $query = db_select('taxonomy_term__field_university_domain','domain');
  $query->leftjoin('taxonomy_term__field_term_of_use','term','domain.entity_id=term.entity_id');
  $query->leftjoin('taxonomy_term__field_university_code','clientID','domain.entity_id=clientID.entity_id');
  $query->fields('term',array('field_term_of_use_target_id'));
  $query->fields('clientID',array('field_university_code_value'));
  $result = $query->condition('domain.field_university_domain_target_id',$domain)->execute()->fetchAll();

  $term_id['term_of_use'] = $result[0]->field_term_of_use_target_id;
  $term_id['clientID'] = $result[0]->field_university_code_value;
  return $term_id;
}
function srl_common_cron(){
  // 1. DISBURSED =>	Loan fully funded
  // 2. DISBURSED_PARTIAL =>	Loan funded, but there are more disbursements
  // 3. ATIL_SENT =>	Application approved, pending acceptance
  // 4. PRE_APPROVED =>	Pre-approved
  // 5. PROCESSING =>	Currently processing
  // 6. FTIL_SENT =>	Application approved & accepted
  // 7. REFUND_PROCESSING =>	Refund in progress
  // 8. REFUND_COMPLETE =>	Refunded
  // 9. DECLINED =>	Declined to proceed with loan
  // 10. INCOMPLETE =>	Application incomplete
  // 11. DROPPED => 	Dropped class
  // 12. DENIED =>	Asked to re-apply with a co-borrower
    // $current_time = time() + 6*60*60; 6hr total=21600;
    $status = 'DISBURSED,PRE_APPROVED,ATIL_SENT,PRE_APPROVED,PROCESSING,REFUND_COMPLETE,DECLINED,INCOMPLETE,DROPPED,DENIED';
    $current_time = time();
    $state = \Drupal::state();
    $last_refresh_state = 'srl_climb_credit_api.last_refresh';
    $last_refresh = $state->get($last_refresh_state, 0);
    // every 12hr run the cron.
    if ($current_time - $last_refresh > 43200) {
      $process = 'True';
      $page = 1;
      $new_record = array();
      $temp_record = array();
      $connection = \Drupal::service('database');
      $query =  $connection->query("SELECT MAX(application_lastupdateddate) As lastupdateddate FROM srl_loan_application_detail");
      $record = $query->fetchAll();
      $last_update_date_tb = strtotime($record[0]->lastupdateddate);
      while($process == "True" ) {
          $client = \Drupal::httpClient();
          $client_url = 'https://climbcredit.com/api/v1/applications?page='.$page.'&limit=50&sort_by=LAST_UPDATED&sort_direction=DESC&application_status='.$status;
          $request_response = $client->get($client_url, [
              'headers' => ['Content-Type' => 'application/json','API-KEY' => '0fbaa5f1-529f-58b4-9595-688c59664019'],
              ])->getBody()->getContents();
          $results = json_decode($request_response);
          foreach($results->data->results as $key => $result) {
              $last_updated_submition = $result->application->lastUpdatedDate;
              $last_submition_application = strtotime($last_updated_submition);
              if($last_update_date_tb <= $last_submition_application ) {
                  $new_record[] = $result;
              }else{
                  $temp_record[] = $result;
              }
          } 
          if($results->data->totalPages <= $page) {
              $process = 'False';
              break;
          }else{
              $page++;
          }
      }
      foreach($new_record as $key => $result) {           
          $api_data = json_encode($result);
          $value = [
              'transaction_id' => $result->customer->studentId,
              'name' => $result->customer->firstName.' '.$result->customer->lastName,
              'email' => $result->customer->email,
              'phone' => $result->customer->phone,
              'application_ref' => $result->application->ref,
              'application_status' => $result->application->status,
              'application_lastupdateddate' => $result->application->lastUpdatedDate,
              'application_submissiondate' => $result->application->applicationSubmissionDate,
              'application_course' =>  $result->program->name,
              'application_university' => $result->school->name,
              'json_response' => $api_data,
          ];
          $connection->insert('srl_loan_application_detail')
          ->fields(['transaction_id', 'name', 'email','phone','application_ref','application_status','application_lastupdateddate','application_submissiondate','json_response',
          ])
          ->values($value)
          ->execute();
      }
      \Drupal::state()->set($last_refresh_state, $current_time);
    }
  
  // $session = \Drupal::database()->truncate('sessions')->execute();
  $current_date = \Drupal::time()->getRequestTime();
  $sessions_date = strtotime('-3 hours', $current_date);
  $connection = \Drupal::service('database');
      $log_session = $connection->delete('sessions')
      ->condition('uid',0)
      ->condition('timestamp', $sessions_date, '<')
      ->execute();
  
  
}
