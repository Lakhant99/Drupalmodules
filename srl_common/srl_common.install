function srl_common_update_8010() {
  $fields = array(
    'description' => 'stackroute custom Table for storing application webform form data.',
    'fields' => array(
      'id' => array(
        'description' => 'Unique indentifier for Table',
        'length' => 10,
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'transaction_id' => array(
        'description' => 'Transaction ID',
        'type' => 'varchar',
        'length' => 35,
        'not null' => TRUE,
      ),
      'email_id' => array(
        'description' => 'EmailID',
        'type' => 'varchar',
        'length' => 30,
      ),
      'mobile_no' => array(
        'description' => 'Mobile No',
        'type' => 'varchar',
        'length' => 35,
      ),
      'step' => array(
        'description' => 'Step completed',
        'type' => 'varchar',
        'length' => 255,
      ),
      'step_json_data' => array(
        'description' => 'Steps data jsong format',
        'type' => 'text',
      ),
    ),
    'primary key' => array('id'),
  );
  $response = Database::getConnection()->schema()->tableExists('stackroute_webform_tempdata');
  if(!$response){
    $schema = Database::getConnection()->schema();
    $schema->createTable('stackroute_webform_tempdata', $fields);

  } 
}
