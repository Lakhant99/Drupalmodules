/** 
 * update table field size
 * srl_candidate_test_details
 *  */
function srl_common_update_8016(){
  $schema = \Drupal\Core\Database\Database::getConnection()->schema();
  $fields = [
    'transaction_id',
    'name',
    'email_id',
    'mobile_no',
    'course_code',
    'university_code',
    'orgid',
    'bu_code',
    'assessment_started_on',
    'assessment_ended_on',
    'actual_started_on',
    'actual_ended_on',
    'test_score',
    'result',
    'country_code',
    'center_code',
    'domain_id',
    'batch_start_date',
  ];
  foreach($fields as $fid){
    $schema->changeField('srl_candidate_test_details',$fid,$fid,array(
      'length' => 255,
      'type' => 'varchar',
    ));
  }
}
