<?php

/**
 * @file
 * Install, update and uninstall functions for the node module.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\user\RoleInterface;
use Drupal\Core\Database\Database;
/**
 * Implements hook_install().
 */
function srl_common_install() {
  $fields = array(
    'description' => 'srl custom Table for storing Candidate Test Details.',
    'fields' => array(
      'id' => array(
        'description' => 'Unique indentifier for Table',
        'length' => 10,
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'course_id' => array(
        'description' => 'Node course id',
        'type' => 'int',
      ),
      'transaction_id' => array(
        'description' => 'Transaction ID',
        'type' => 'varchar',
        'length' => 25,
        'not null' => TRUE,
      ),
      'name' => array(
        'description' => 'Candidate name',
        'type' => 'varchar',
        'length' => 25,
        'not null' => TRUE,
      ),
      'email_id' => array(
        'description' => 'EmailID',
        'type' => 'varchar',
        'length' => 30,
      ),
      'mobile_no' => array(
        'description' => 'Mobile No',
        'type' => 'varchar',
        'length' => 15,
      ),
      'course_code' => array(
        'description' => 'Course Code',
        'type' => 'varchar',
        'length' => 30,
      ),
      'university_code' => array(
        'description' => 'University Code',
        'type' => 'varchar',
        'length' => 15,
      ),
      'orgid' => array(
        'description' => 'OrgId',
        'type' => 'varchar',
        'length' => 25,
      ),
      'bu_code' => array(
        'description' => 'BU Code',
        'type' => 'varchar',
        'length' => 25,
      ),
      'source_code' => array(
        'description' => 'Source Code',
        'type' => 'varchar',
        'length' => 255,
      ),
      'center_code'  =>  array(
        'description'   =>  'Center Code',
        'type'          =>  'varchar',
        'length'        =>  30,
      ),
      'test_code' => array(
        'description' => 'Test Code',
        'type' => 'varchar',
        'length' => 255,
      ),
      'test_type' => array(
        'description' => 'Test Type',
        'type' => 'varchar',
        'length' => 255,
      ),
      'assessment_started_on' => array(
        'description' => 'Assessment Started On',
        'type' => 'varchar',
        'length' => 50,
      ),
      'assessment_ended_on' => array(
        'description' => 'Assessment Ended On',
        'type' => 'varchar',
        'length' => 50,
      ),
      'actual_started_on' => array(
        'description' => 'Actual Started On',
        'type' => 'varchar',
        'length' => 50,
      ),
      'actual_ended_on' => array(
        'description' => 'Actual Ended On',
        'type' => 'varchar',
        'length' => 50,
      ),
      'test_score' => array(
        'description' => 'Test Score',
        'varchar' => 30,
      ),
      'result' => array(
        'description' => 'Result',
        'type' => 'varchar',
        'length' => 30,
      ),
      'country_code' =>array(
        'description'   =>  'Country Code',
        'type'          =>  'varchar',
        'length'        =>  30,
      ),
      'access_permission' => array(
        'description' => 'Assessment page access permission',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => FALSE,
      ),
      'json_response' => array(
        'description' => 'JSONResponse',
        'type' => 'text',
      ),
      'passing_percentage' => array(
        'description' => 'assessment passing marks condition',
        'type' => 'int',
      ),
    ),
    'primary key' => array('id'),
  );
  $response = Database::getConnection()->schema()->tableExists('srl_candidate_test_details');
  if(!$response){
    $schema = Database::getConnection()->schema();
    $schema->createTable('srl_candidate_test_details', $fields);

  } 
}

/**
 * Implements hook_uninstall().
 */
function srl_common_uninstall() {
 
}
