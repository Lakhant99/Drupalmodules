/**
 * Implements hook_theme().
 */
function srl_payment_theme() {
    return [
      'course_order_summary' => [
        'template' => 'course_order_summary',
        'variables' => [
          'payeezy_form' => NULL,
          'cohort_date' => NULL,
          'batch_start_date' => NULL,
          'name' => NULL,
          'email_id' => NULL,
          'mobile_no' => NULL,
          'course_name' => NULL,
          'course_fee' => NULL,
          'currency_code' => NULL,
          'payable_amount' => NULL,
          'taxes' => NULL,
          'data' => NULL,
		      'actual_fee'=> NULL,
        ],
      ],
      'term_agreement_form' =>[
        'render element' => 'form',
      ],
      'term_agreement_popup_form' =>[
        'render element' => 'form',
      ],
    ];
  }
function getAssessmentUserInfo($transaction_id){
  $query = db_select('srl_candidate_test_details','records');
    $query->fields('records',array('json_response'));
    $query->condition('records.transaction_id',$transaction_id);
    $field_values=$query->execute()->fetchAll();
    return json_decode(stripslashes($field_values[0]->json_response));
}

function getUserinfo($transaction_id){
  //'json_response' => addslashes(json_encode($records)),
  $query = db_select('srl_candidate_test_details','records');
    $query->fields('records',array('json_response'));
    $query->condition('records.transaction_id',$transaction_id);
    $field_values=$query->execute()->fetchAll();
  return $field_values[0]->json_response;
}
function get_EnrollmentAgreement_info($transaction_id){
    $query = db_select('payeezy_payment_details','records');
    $query->fields('records',array('enrollment_agreement_info','term_of_use','enrollment_agreement'));
    $query->condition('records.transaction_id',$transaction_id);
    $field_values=$query->execute()->fetchAll();
    // kint($field_values);
    $result['agreement_info'] = $field_values[0]->enrollment_agreement_info;
    $result['term_of_use'] = $field_values[0]->term_of_use;
    $result['enrollment_agreement'] = $field_values[0]->enrollment_agreement;
  return $result;
}
function getUniversityPolicy(){
  $host = \Drupal::request()->getHost();
  $domain = \Drupal::service('domain.negotiator')->getActiveId();
  $query = db_select('taxonomy_term__field_university_domain','domain');
  $query->leftjoin('taxonomy_term__field_enrollment_agreement','ea','domain.entity_id=ea.entity_id');
  $query->leftjoin('taxonomy_term__field_term_of_use','term','domain.entity_id=term.entity_id');
  $query->leftjoin('taxonomy_term__field_university_logo','logo','domain.entity_id=logo.entity_id');
  $query->leftjoin('taxonomy_term__field_university_code','clientID','domain.entity_id=clientID.entity_id');
  $query->fields('term',array('field_term_of_use_target_id'));
  $query->fields('logo',array('field_university_logo_target_id'));
  $query->fields('clientID',array('field_university_code_value'));
  $query->fields('ea',array('field_enrollment_agreement_target_id'));
  $result = $query->condition('domain.field_university_domain_target_id','%'.$domain.'%','LIKE')->execute()->fetchAll();

  $term_id['logo_fid'] = $result[0]->field_university_logo_target_id;
  $term_id['term_of_use'] = $result[0]->field_term_of_use_target_id;
  $term_id['clientID'] = $result[0]->field_university_code_value;
  $term_id['enrollment_agreement'] = $result[0]->field_enrollment_agreement_target_id;
  return $term_id;
}
function UpdateAcceptanceInfo($data){
  $connection = \Drupal::service('database');
  $ip_address = \Drupal::request()->getClientIp();
  
  if($data['flag'] == 'both'){
    $fields = [
      'term_of_use' => $data['term_of_use'],
      'term_of_use_pdf' => $data['term_of_use_pdf'],
      'enrollment_agreement' => $data['enrollment_agreement'],
      'enrollment_agreement_pdf' => $data['enrollment_agreement_pdf'],
      'acceptance_date' => \Drupal::time()->getRequestTime(),
      'user_ip' => $ip_address,
    ];
  }elseif($data['flag'] == 'term_of_use'){
    $fields = [
      'term_of_use' => $data['term_of_use'],
      'term_of_use_pdf' => $data['term_of_use_pdf'],
      'acceptance_date' => \Drupal::time()->getRequestTime(),
      'user_ip' => $ip_address,
    ];
  }elseif($data['flag'] == 'enrollment_agreement'){
    $fields = [
      'enrollment_agreement' => $data['enrollment_agreement'],
      'enrollment_agreement_pdf' => $data['enrollment_agreement_pdf'],
      'acceptance_date' => \Drupal::time()->getRequestTime(),
      'user_ip' => $ip_address,
    ];
  }
  $connection->update('payeezy_payment_details')
    ->fields($fields)
    ->condition('transaction_id', $data['transaction_id'])->execute();
}
/** update enrollment agreement information */
function updatePolicyStatus($data){
  $connection = \Drupal::service('database');
  if($data['policy'] == 'agreement'){
    $connection->update('payeezy_payment_details')
    ->fields([
        'enrollment_agreement_pdf' => $data['policy_pdf'],
        'enrollment_agreement' => $data['policy_status'],
        'acceptance_date' => $data['acceptance_date'],
        'enrollment_agreement_info' => $data['enrollment_agreement_info']
    ])
    ->condition('transaction_id',$data['transaction_id'])
    ->execute();
  }
  if($data['policy'] == 'termofuse'){
    // \Drupal::logger('accept term of use')->notice('echo '.print_r($data,TRUE));
    $connection->update('payeezy_payment_details')
      ->fields([
          'term_of_use_pdf' => $data['policy_pdf'],
          'term_of_use' => $data['policy_status'],
      ])
      ->condition('transaction_id',$data['transaction_id'])
      ->execute();
  }
} 

