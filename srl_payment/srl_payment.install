<?php

/**
 * @file
 * Install, update and uninstall functions for the node module.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\user\RoleInterface;
use Drupal\Core\Database\Database;
/**
 * Implements hook_install().
 */
function srl_payment_install() {
  $fields = array(
    'description' => 'srl custom table for storing Payeezy Payment Details',
    'fields' => array(
      'id' => array(
        'description' => 'Unique indentifier for Table',
        'length' => 10,
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'transaction_id' => array(
        'description' => 'Transaction ID',
        'type' => 'varchar',
        'length' => 25,
        'not null' => TRUE,
      ),
      'user_name' => array(
        'type' => 'varchar',
        'length' => 100,
        'description' => 'Use to store user name',
      ),
      'email_id' => array(
        'type' => 'varchar',
        'length' => 150,
        'description' => 'Use to store user Email ID',
      ),
      'mobile_no' => array(
        'type' => 'varchar',
        'length' => 15,
        'description' => 'Use to store user contact details',
      ),
      'course_code' => array(
        'type' => 'varchar',
        'length' => 50,
        'description' => 'Use to store selected course code',
      ),
      'university' => array(
        'type' => 'varchar',
        'length' => 50,
        'description' => 'Use to store university name',
      ),
      'created_on' => array(
        'type' => 'int',
        'description' => 'Use to store date of creation',
      ),
      'course_name' => array(
        'type' => 'varchar',
        'length' => 100,
        'description' => 'Use to store course name',
      ),
      'delivery_mode' => array(
        'type' => 'varchar',
        'length' => 100,
        'description' => 'Use to store delivery mode',
      ),
      'currency_code' => array(
        'type' => 'varchar',
        'length' => 20,
        'description' => 'Use to store currency code',
      ),
      'base_amount' => array(
        'type' => 'varchar',
        'length' => 20,
        'description' => 'Use to store base amount of course',
      ),
      'tax_amount' => array(
        'type' => 'varchar',
        'length' => 20,
        'description' => 'Use to store tax amount on course',
      ),
      'total_amount' => array(
        'type' => 'varchar',
        'length' => 20,
        'description' => 'Use to store total amount of course',
      ),
      'cohort_date' => array(
        'type' => 'varchar',
        'length' => 100,
        'description' => 'Use to cohort date details',
      ),
      'city' => array(
        'type' => 'varchar',
        'length' => 50,
        'description' => 'Use to store city name',
      ),
      'state' => array(
        'type' => 'varchar',
        'length' => 50,
        'description' => 'Use to store state name',
      ),
      'country' => array(
        'type' => 'varchar',
        'length' => 50,
        'description' => 'Use to store country name',
      ),
      'zip_code' => array(
        'type' => 'int',
        'description' => 'Use to store zip code',
      ),
      'fp_transaction_id' => array(
        'type' => 'varchar',
        'length' => 100,
        'description' => 'Use to store Payeezy transaction id',
      ),
      'transaction_initiated_on' => array(
        'type' => 'int',
        'description' => 'Use to store transaction initiated date',
      ),
      'status' => array(
        'type' => 'varchar',
        'length' => 100,
        'description' => 'Use to store payment status',
      ),
      'response_code' => array(
        'type' => 'int',
        'description' => 'Use to store response code',
      ),
      'response_data' => array(
        'type' => 'text',
        'description' => 'JSONResponse',
      ),
      'transaction_completed_on' => array(
        'type' => 'int',
        'description' => 'Use to store transaction completed date',
      ),
    ),
    'unique keys' => array(
      'external' => array('transaction_id')
     ),
    'primary key' => array('id'),
  );
  $response = Database::getConnection()->schema()->tableExists('payeezy_payment_details');
  if(!$response){
    $schema = Database::getConnection()->schema();
    $schema->createTable('payeezy_payment_details', $fields);
  }
}

/**
 * Implements hook_uninstall().
 */
function srl_payment_uninstall() {
}
function srl_payment_update_8001(){
  $schema = \Drupal\Core\Database\Database::getConnection()->schema();
  $addFields['term_of_use']  =  array(
    'description'   =>  'Term of use acceptance',
    'type'          =>  'int',
    'size'          =>  'tiny',
    'default'       =>  0,
  );
  $addFields['term_of_use_pdf']  =  array(
    'description'   =>  'Term of use pdf',
    'type'          =>  'varchar',
    'length'        =>  500,
  );
  $addFields['enrollment_agreement']  =  array(
    'description'   =>  'Enrollment agreement acceptance',
    'type'          =>  'int',
    'size'          =>  'tiny',
    'default'       =>  0,
  );
  $addFields['enrollment_agreement_pdf']  =  array(
    'description'   =>  'Enrollment agreement pdf',
    'type'          =>  'varchar',
    'length'        =>  500,
  );
  $addFields['acceptance_date']  =  array(
    'description'   =>  'Acceptance date',
    'type'          =>  'varchar',
    'length'        =>  15,
  );
  $addFields['user_ip']  =  array(
    'description'   =>  'User ip',
    'type'          =>  'varchar',
    'length'        =>  50,
  );
  foreach($addFields as $key => $values){
    if(!$schema->fieldExists('payeezy_payment_details', $key)) {
      $schema->addField('payeezy_payment_details', $key, $values);
    }
  }
}
function srl_payment_update_8002(){
  $schema = \Drupal\Core\Database\Database::getConnection()->schema();
  $addFields['paid_amount']  =  array(
    'description'   =>  'Total paid amount',
    'type'          =>  'varchar',
    'length'          =>  15,
  );
  
  foreach($addFields as $key => $values){
    if(!$schema->fieldExists('payeezy_payment_details', $key)) {
      $schema->addField('payeezy_payment_details', $key, $values);
    }
  }

  $schema = \Drupal\Core\Database\Database::getConnection()->schema();
  $schema->changeField('payeezy_payment_details','transaction_completed_on','transaction_completed_on',array(
    'length' => 15,
    'type' => 'varchar',
  ));
}