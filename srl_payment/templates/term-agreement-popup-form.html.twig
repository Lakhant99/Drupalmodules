{{ form.form_token }}
{{ form.form_build_id }}
{{ form.form_id }}

<div id="form-payment-container"><div id="payeezy-payment-form-wrapper">
    <a class="error-popup-button" data-toggle="modal" data-target="#errormodal" style="display:none;">error</a>
    <div id="errormodal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="enrolment_term">Please accept Terms of Use and Enrollment Agreement</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="alpha-link alpha-uppercase orange-link" id="reject-agreement" data-dismiss="modal">Ok</button>
                </div>
            </div>
        </div>
    </div>
    {# error in api #}
    <div id="apierror" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="enrolment_term">Something went wrong please try again.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="alpha-link alpha-uppercase orange-link" id="reject-agreement" data-dismiss="modal">Ok</button>
                </div>
            </div>
        </div>
    </div>

    {# term of use modalbox #}
    <div class="description">
         {# <p class="term-of-use ">
            <span class="msg-agreement">Please review and accept</span>
            <a class="popup-button" data-target="#myfirstmodal" data-toggle="modal"> Terms of Use</a>
            <span class="term-validate"><i class="fa fa-check-circle" aria-hidden="true"></i>
            <span>Accepted</span>
            </span>
        </p>  #}
        {{ form.term_of_use_markup }}
        {{ form.term_accepted }}
        <div class="modal fade" id="myfirstmodal" role="dialog">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header"><a type="button" class="close" data-dismiss="modal">&times;</a><h4 class="modal-title">{{ form.title_term_header }}</h4></div>
              <div class="modal-body">
                  <div class="infomation wrapper mbscroller-init">
                      {{ form.terms_condition}}
                  </div>
              </div>
              <div class="modal-footer">
                <div class="footer-popup-note">Please scroll and read entire content.</div>
                {# <a class="alpha-link alpha-uppercase orange-link" data-dismiss="modal" id="accept-agreements" style="pointer-events: none;">Accept</a> #}
                {# <a class="alpha-link alpha-uppercase orange-link" data-dismiss="modal" id="reject-agreements">Reject</a> #}
                <div id="tou-btn-section" class="terms-btn-container">
                    <input type="button" class ="btn-primary alpha-link alpha-uppercase orange-link btn-default-1" value="ACCEPT" disabled="disabled">
                    {{ form.terms_condition_accept }}
                    {{ form.terms_condition_reject }}
                </div>
              </div>
            </div>
          </div>
        </div>
        {# <p class="enrollment-agreement "><span class="msg-agreement">Please review and accept</span><a class="popup-button myModal_unset"> Enrollment Agreement</a><label class="agreement-validate"><i class="fa fa-check-circle" aria-hidden="true"></i><span>Accepted</span></label></p> #}
        {{ form.agreement_link_markup }}
    </div>
    {# college agreement modalbox #}
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{{ form.title_agreement_header }}</h4>
                    <a type="button" class="close" data-dismiss="modal">&times;</a>
                </div>
                <div class="modal-body">
                    <div class="enrolment_term_agreement">
                        <div class="enrolment_agreement_content">
                            {# form agreement content #}
                            {{ form.enroll_agreement.markup_university_info }}
                            {{ form.enroll_agreement.f_name }}
                            {{ form.enroll_agreement.dob }}
                            {{ form.enroll_agreement.address }}
                            {{ form.enroll_agreement.city }}
                            {{ form.enroll_agreement.state }}
                            {{ form.enroll_agreement.zip }}
                            {{ form.enroll_agreement.phone }}
                            {{ form.enroll_agreement.home_phone }}
                            {{ form.enroll_agreement.email }}
                            {{ form.enroll_agreement.school_graduate }}
                            {{ form.enroll_agreement.ged }}
                            {{ form.enroll_agreement.year_complete }}
                            {{ form.enroll_agreement.program_track }}
                            {{ form.enroll_agreement.status }}
                            {{ form.enroll_agreement.non_degree }}
                            {{ form.enroll_agreement.program_start_date }}
                            {{ form.enroll_agreement.expected_graduation_date }}
                            {{ form.enroll_agreement.agr_info }}
                            {{ form.enroll_agreement.markup_s_info }}
                            {{ form.enroll_agreement.student_sign }}
                            {{ form.enroll_agreement.student_name }}
                            {{ form.enroll_agreement.student_agreement_date }}

                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="footer-popup-note">Please scroll, read entire content and fill all the fields.</div>
                    {{ form.enroll_agreement.validate_agreement }}
                    {{ form.enroll_agreement.reject_agreement }}
                    {# <a type="button" class="alpha-link alpha-uppercase orange-link" id="reject-agreement" data-dismiss="modal">Reject</a> #}
                </div>
            </div> 
        </div>
    </div>
    <div class="agr-note">
        <span>Note:</span> Your Order is only considered complete upon the Acceptance of Enrollment Agreement and Terms of Use
    </div> 
    {{ form.x_login }}
    {{ form.x_amount }}
    {{ form.x_amount_total }}
    {{ form.x_fp_sequence }}
    {{ form.x_fp_timestamp }}
    {{ form.x_fp_hash }}
    {{ form.x_currency_code }}
    {{ form.x_show_form }}
    {{ form.enable_level3_processing }} 
    {{ form.x_cust_id }}
    {{ form.x_email}} 
    {{ form.course_name }} 
    {{ form.course_id }}
    {{ form.firstname }}
    {{ form.mobilephone }} 
    {{ form.university_id }} 
    {{ form.start_date }}
    {{ form.term_of_use }} 
    {{ form.enrollment_agreement }} 
    {{ form.submit_card }} 
    <div class="discount-note">
        <i>Those Students Who Chose to Pay in Full Now will receive a $1000 Discount!</i>
    </div> 
    {{ form.finance_options }}
    {{ form.finance_discount }}

    {{ form.OrgID }}
    {{ form.coursecode }}
    {{ form.clientID }}
    {{ form.BatchID }}
    {{ form.CountryCode }}
    {{ form.MobileNo }}
    {{ form.FeePatternCode }}

    {{ form.PaymentMode1 }}
    {{ form.FeePatternCode1 }}
    {{ form.Currency1 }}
    {{ form.FeeAmount1 }}
    {{ form.PaymentMode2}}
    {{ form.FeePatternCode2 }}
    {{ form.Currency2 }}
    {{ form.FeeAmount2 }}
    {# {{ form.submit_plan }} #}
    {{ form.plan_markup }}
    </div>
</div>