<?php

/**
 * @file
 * Register a module or theme's theme implementations as well as other function
 * override as per requirement.
 */

/**
 * Implements hook_theme().
 */
function unfpa_global_strategic_plan_theme($existing, $type, $theme, $path) {

  return [
    'strategic_plan_template' => [
      'variables' => [
        'module_path' => NULL,
        'base_url' => NULL,
        'language' => NULL,
        'url_with_lang' => NULL,
      ],
      'template' => 'strategic_plan',
    ],
  ];
}
/**
 * Implements hook_page_attachments().
 */
function unfpa_global_strategic_plan_page_attachments(array &$attachments) {
  $meta_tag_list = unfpa_global_strategic_plan_add_metatag();
 
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name == 'unfpa_global_strategic_plan.strategic_plan') {
    foreach ($meta_tag_list as $key => $value) {
      $attachments['#attached']['html_head'][] = [$value, 'keywords' . $key];
    }
  }
}
/**
 * Get share tags locale in a form of 'en_US'.
 *
 * Used by og:locale sharing meta tag.
 *
 * @return string
 *   Locale information in form of 'en_US', 'fr_FR', etc.
 */
function unfpa_global_strategic_plan_get_locale() {
  $lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $country = $lang;

  if ($lang == 'en') {
    $country = 'us';
  }

  return $lang . '_' . strtoupper($country);
}

/**
 * Function to get meta tag.
 */
function unfpa_global_strategic_plan_add_metatag() {
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $config = \Drupal::config('system.site');
  $sharecard_id = \Drupal::requestStack()->getCurrentRequest()->get('sharecardid');
  $share_id = \Drupal::request()->query->get('shareid');

  if (!$share_id) {
    $share_id = $sharecard_id;
  }

  $data = unfpaGlobalStrategicPlanShareGetData($share_id, $langcode);
  $share_url = $data['url'];
  $share_image = $data['img'];
  $share_title = $data['title'];
  $share_description = $data['description'];

  // Meta tags that don't change dynamically.
  $og_locale = unfpa_global_strategic_plan_get_locale();
  $og_sitename = $config->get('name');
  $og_updated_time = time();
  $og_type = 'article';
  $og_image_type = 'image/jpeg';
  $tw_site = '@UNFPA';
  $tw_card = 'summary_large_image';
  $fb_app_id = \Drupal::state()->get('unfpa_global_common_facebook_app_id', '2280985865254142');

  $metatag = [
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:site',
       'content' => $tw_site,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:card',
       'content' => $tw_card,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:url',
       'content' => $share_url,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:title',
       'content' => $share_title,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:image',
       'content' => $share_image,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:description',
       'content' => $share_description,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'fb:app_id',
       'content' => $fb_app_id,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:description',
       'content' => $share_description,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:image:url',
       'content' => $share_image,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:image:height',
       'content' => '628',
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:image:width',
       'content' => '1200',
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:image:type',
       'content' => $og_image_type,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:image',
       'content' => $share_image,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:title',
       'content' => $share_title,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:url',
       'content' => $share_url,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:type',
       'content' => $og_type,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:updated_time',
       'content' => $og_updated_time,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:locale',
       'content' => $og_locale,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'property' => 'og:site_name',
       'content' => $og_sitename,
     ],
   ],
  ];

  return $metatag;
}

function unfpaGlobalStrategicPlanShareGetData($shareid, $langcode) {

  global $base_url;
