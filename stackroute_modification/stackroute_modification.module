function save_WebformTempData($data){
   /**concatinate phone with copuntry code */
   $phone_number = merge_PhoneWithCountry($data['phone'],$data['country']);
   /**get steps information */
   $temp_transaction_id = get_transactionid($data['email'], $phone_number, $data['step']);
   if($temp_transaction_id){
      update_webformTeampData($data,$temp_transaction_id->transaction_id);
   }else{
      $transaction_id = get_transactionid($data['email'], $phone_number, 'program_fit');
      $temp_transaction_id = $transaction_id->transaction_id ? $transaction_id->transaction_id : $phone_number.'_'.\Drupal::time()->getRequestTime();

      insert_webformTeampData($data,$temp_transaction_id);
   }
}
/** insert webform temp data */
function insert_webformTeampData($data,$temp_transaction_id){
   $domain = \Drupal::service('domain.negotiator')->getActiveId();
   /**concatinate phone with copuntry code */
   $phone_number = merge_PhoneWithCountry($data['phone'],$data['country']);

   $connection = \Drupal::service('database');
   
   $connection->insert('stackroute_webform_tempdata')
       ->fields(['transaction_id','email_id', 'mobile_no', 'step','step_json_data','domain_id','program_interest','form_version'])
       ->values([
         'transaction_id' => $temp_transaction_id,
         'email_id' => $data['email'],
         'mobile_no' => $phone_number,
         'step' => $data['step'],
         'step_json_data' => json_encode($data),
         'domain_id' => $domain,
         'program_interest' => $data['program_interest'],
         'form_version' => 2,
       ])
       ->execute();
}
/** insert webform step first temp data */
function step1_insert_webformTeampData($data){
   $domain = \Drupal::service('domain.negotiator')->getActiveId();
   $connection = \Drupal::service('database');
   $phone_number = merge_PhoneWithCountry($data['phone'],$data['country']);

   $connection->delete('stackroute_webform_tempdata')
      ->condition('email_id', $data['email'])
      ->condition('mobile_no', $phone_number)
      ->condition('domain_id',$domain)
      ->execute();

   /**concatinate phone with copuntry code */

   $temp_transaction_id = $phone_number.'_'.\Drupal::time()->getRequestTime();

   
  $response =  $connection->insert('stackroute_webform_tempdata')
       ->fields(['transaction_id','email_id', 'mobile_no', 'step','step_json_data','domain_id','program_interest','form_version'])
       ->values([
         'transaction_id' => $temp_transaction_id,
         'email_id' => $data['email'],
         'mobile_no' => $phone_number,
         'step' => $data['step'],
         'step_json_data' => json_encode($data),
         'domain_id' => $domain,
         'program_interest' => $data['program_interest'],
         'form_version' => 2,
       ])
       ->execute();
   return $response;
}
/** Update webformtep data */
function update_webformTeampData($data,$temp_transaction_id){
   $connection = \Drupal::service('database');
   
   $phone_number = merge_PhoneWithCountry($data['phone'],$data['country']);
 
   $connection->update('stackroute_webform_tempdata')
     ->fields([
       'email_id' => $data['email'],
       'mobile_no' => $phone_number,
       'step_json_data' => json_encode($data),
       'program_interest' => $data['program_interest'],
     ])
     ->condition('transaction_id', $temp_transaction_id, '=')
     ->condition('step', $data['step'], '=')
     ->execute();
}
/**concatinate phone with country code */
function merge_PhoneWithCountry($phone,$country){
   $phone_number = str_replace('+','',$phone);
   $phone_number = str_replace('-','',$phone_number);
   $phone_number = str_replace(' ','',$phone_number);
   $phone_number = str_replace('(','',$phone_number);
   $phone_number = str_replace(')','',$phone_number);
   $phone_number = trim($country).'-'.$phone_number;

   return $phone_number;
}
/**get steps transaction id */
function get_transactionid($email, $phone_number, $step){
   $domain = \Drupal::service('domain.negotiator')->getActiveId();
   $query = db_select('stackroute_webform_tempdata','records');
     $query->fields('records',['transaction_id']);
     $query->condition('records.email_id',$email);
     $query->condition('records.mobile_no',$phone_number);
     $query->condition('records.domain_id',$domain);
     $query->condition('records.step',$step);
     $field_values=$query->execute()->fetchAll();
   return $field_values[0];
}

/*
 *  @implement 
 * save webform assessment Application fourm information.
*/
function saveApplicationFormdata($records){
   $domain = \Drupal::service('domain.negotiator')->getActiveId();
   $course_node = \Drupal::entityTypeManager()->getStorage('node')->load($records['program_interest']);
   $query = db_select('node__field_course_code','course');
       $query->fields('course',array('field_course_code_value'));
       $query->condition('course.entity_id',$records['program_interest'],'=');
       $result = $query->execute()->fetchCol();
       $records['course_code'] = $result[0];
   $records['course_id'] = $records['program_interest'];
   
   $phone_number = merge_PhoneWithCountry($records['phone'],$records['country']);
   
 
   $records['transaction_id'] = $phone_number.'_'.\Drupal::time()->getRequestTime();
   
   $batch_start_date = getCourseBatchDate($records['course_id'],$domain);
   $connection = \Drupal::service('database');
     $connection->insert('srl_candidate_test_details')
     ->fields([
        'transaction_id',
         'course_id', 
         'name', 
         'email_id',
         'mobile_no',
         'course_code',
         'orgid',
         'access_permission',
         'json_response',
         'result',
         'domain_id', 
         'batch_start_date',
         'form_version',
     ])
     ->values([
       'transaction_id' => $records['transaction_id'],
       'course_id' => $records['course_id'],
       'name' => $records['full_name'].' '.$records['last_name'],
       'email_id' => $records['email'],
       'mobile_no' => $phone_number,
       'course_code' => $records['course_code'],
       'orgid' => $records['orgid'],
       'access_permission' => 1,
       'json_response' => addslashes(json_encode($records)),
       'result' => 'skiped',
       'domain_id' => $domain,
       'batch_start_date' => $batch_start_date,
       'steps_level' => 1,
       'form_version' => 2,
     ])
     ->execute();
     $session = \Drupal::request()->getSession();
     $session->set('transaction_id', $records['transaction_id']);
     return $records['transaction_id'];
 }


function UpdateBathDate(){
      $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'course_university_mapping']);
      $batch_date = [
         'May 9, 2022','June 6, 2022','July 11, 2022','August 8, 2022','September 12, 2022','October 10, 2022','November 14, 2022','December 12, 2022','January 9 2023','February 6, 2023','March 6, 2023'
      ];
      foreach($batch_date as $date_value){
         $datetime = strtotime($date_value);
         $dates[] = date('Y-m-d',$datetime);
      }
      foreach($nodes as $key => $node){
            $node->set('field_course_batch_start_date', date('Y-m-d'), $notify = true);
            $node->save();
            foreach($dates as $rid => $batch){
               $node->field_course_batch_start_date[$rid] = ['value' => $batch];
            }
            $node->save();
      }
}
function UpdateCoursePrice(){
   $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'course_university_mapping']);
   foreach($nodes as $key => $node){
         $node->set('field_actualfee', '10500', $notify = true);
         $node->set('field_fee', '10500', $notify = true);
         $node->save();

   }
}
function UpdateCourseFAQ(){
   $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'course_university_mapping']);
   foreach($nodes as $key => $node){
      $course_faq = $node->get('field_course_faq')->getValue()[0]['value'];
      $course_faq = str_replace('$9,500','#COURSEFEE#',$course_faq);
         $node->set('field_course_faq', $course_faq, $notify = true);
         $node->save();

   }
}
