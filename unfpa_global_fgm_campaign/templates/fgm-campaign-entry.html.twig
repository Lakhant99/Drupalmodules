<div class="fgm-entry" id="entry">
  
  <div class="fgm-entry-triggers">
    <span data-scene="1" class="entry-trigger-1 has-scene">&nbsp;</span>
    <span data-scene="2" class="entry-trigger-2 has-scene">&nbsp;</span>
    <span data-scene="3" class="entry-trigger-3 has-scene">&nbsp;</span>
    <span data-scene="4" class="entry-trigger-4 has-scene">&nbsp;</span>
    <span data-scene="6" class="entry-trigger-5">&nbsp;</span>
  </div>
  
  <div class="fgm-entry-main">
    <div class="fgm-entry-stick">
  
      <div class="fgm-entry-controls element-invisible">
        
      </div>
    
      <div class="fgm-entry-scenes">
  
        <div class="fgm-entry-scene scene-1" data-id="1">
          <div class="fgm-entry-content">
            <div class="fgm-entry-content-inner">
              <h2 class="fgm-entry-title cond-font">
                {{ "Born complete"|t }}
              </h2>
              <p class="fgm-entry-copy light-font">
                {{ "An estimated <strong>68 million girls will be subjected to female genital mutilation by 2030</strong> if we don't accelerate our efforts to end this harmful practice."|t }}
              </p>
            </div>
          </div>
          <div class="fgm-entry-tint"></div>
          <div class="fgm-entry-bg">
            <img src="{{ data.module_path }}/images/entry-1.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
            <img src="{{ data.module_path }}/images/entry-1-m.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
          </div>
          <div class="fgm-entry-downlabel">{{ "scroll down"|t }}</div>
          <div class="fgm-entry-downarrow"></div>
          <span class="fgm-credit">&copy; {{ "Georgina Goodwin for UNFPA"|t }}</span>
        </div>

        <div class="fgm-entry-scene scene-2" data-id="2">
          <div class="fgm-entry-content">
            <div class="fgm-entry-content-inner">
              <p class="fgm-entry-copy light-font">
                {{ "Gender inequality exacts a toll on girls and women worldwide – and in some societies, being born a girl comes at the <strong>price of physical integrity</strong>."|t }}
              </p>
            </div>
          </div>
          <div class="fgm-entry-tint"></div>
          <div class="fgm-entry-bg">
            <img src="{{ data.module_path }}/images/entry-2.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
            <img src="{{ data.module_path }}/images/entry-2-m.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
          </div>
          <span class="fgm-credit">&copy; {{ "UNFPA/Daniel Baldotto"|t }}</span>
        </div>

        <div class="fgm-entry-scene scene-3" data-id="3">
          <div class="fgm-entry-content">
            <div class="fgm-entry-content-inner">
              <p class="fgm-entry-copy light-font">{{ "Female genital mutilation can cause <strong>serious health problems</strong> and often goes hand in hand with child marriage and an early end to schooling."|t }}</p>
            </div>
          </div>
          <div class="fgm-entry-tint"></div>
          <div class="fgm-entry-bg">
            <img src="{{ data.module_path }}/images/entry-3.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
            <img src="{{ data.module_path }}/images/entry-3-m.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
          </div>
          <span class="fgm-credit">&copy; {{ "Georgina Goodwin for UNFPA"|t }}</span>
        </div>

        <div class="fgm-entry-scene scene-4" data-id="4">
          <div class="fgm-entry-content">
            <div class="fgm-entry-content-inner">
              <p class="fgm-entry-copy light-font">{{ "Some <strong>200 million women and girls</strong> alive today have undergone female genital mutilation."|t }}</p>
            </div>
          </div>
          <div class="fgm-entry-tint"></div>
          <div class="fgm-entry-bg">
            <img src="{{ data.module_path }}/images/entry-4.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
            <img src="{{ data.module_path }}/images/entry-4-m.jpg" alt="{{ "Photo"|t }}" class="element-invisible" />
          </div>
          <span class="fgm-credit">&copy; {{ "Kate Holt/ UNICEF Photo"|t }}</span>
        </div>
        
      </div>
    </div>
  </div>
</div>
