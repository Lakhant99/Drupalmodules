<div class="fgm">
  {{ nav }}
  <article class="fgm-subpage">
    <div class="fgm-subpage-header">
      <div class="fgm-subpage-headtxt">
        <div class="fgm-subpage-headtxt-inner">
          <div class="fgm-subpage-headtxt-inner-2">
            <div class="fgm-width-wrap">
              <h1 class="fgm-subpage-title cond-font">{{ title }}</h1>
              <blockquote class="fgm-subpage-subtitle conb-font" style="color: {{ fgm_color }}">
                {{ subtitle }}
              </blockquote>
              {{ sharelink }}
            </div>
          </div>
        </div>
      </div>
      <div class="fgm-subpage-topimg">
        <div class="fgm-subpage-topimg-desktop">
          <img typeof="foaf:Image" src="{{ header_image }}" alt="" width="1440" height="800">
        </div>
        <div class="fgm-subpage-topimg-mobile">
          <img typeof="foaf:Image" src="{{ mobile_image }}" alt="" width="750" height="1000">
        </div>
        <span class="fgm-credit">
          &copy; {{ header_image_credit }}
        </span>
      </div>
    </div>

    <div class="fgm-width-wrap fgm-side-padd">
      <div class="fgm-subpage-content light-font">
        {{content.body|render}}
      </div>
{%if include_prevalance_map == 1%}
      <div class="fgm-prevalance">
        <div class="fgm-prevalance-intro">
          <p class="fgm-subpage-bigtext light-font">{{ "Today, the practice can be found in communities around the world, including in many western countries."|t }}</p>
          <p class="fgm-subpage-bigtext light-font">{{ "Female genital mutilation spans continents and cultures. But in every community in which it is practiced, it is a manifestation of deeply entrenched gender inequality."|t }}</p>
          <h3 class="conb-font">{{ "Across the world, 68 million girls are at risk of being mutilated."|t }}</h3>
          <p class="fgm-subpage-regtext light-font">
            {{ "FGM has been reported in the countries shaded below."|t }}<br />
            {{ "Hover over a country to see the numbers of girls now at risk."|t }}
          </p>
        </div>
        <div class="fgm-prevalance-map">
          <div id="fgm-prevalance-worldmap"></div>
        </div>
        <div class="fgm-prevalance-legend">
          <div class="fgm-prevalance-legend-inner">
            <div class="fgm-prevalance-legend-item">
              <div class="fgm-prevalance-legend-color color-1"></div>
              <div class="fgm-prevalance-legend-label">
                {{ "Countries with FGM data collected by household surveys"|t }}
              </div>
            </div>
            <div class="fgm-prevalance-legend-item">
              <div class="fgm-prevalance-legend-color color-2"></div>
              <div class="fgm-prevalance-legend-label">
                {{ "Countries where FGM has been reported"|t }}
              </div>
            </div>
            <div class="fgm-prevalance-legend-item">
              <div class="fgm-prevalance-legend-color color-3"></div>
              <div class="fgm-prevalance-legend-label">
                {{ "Countries where FGM has been reported among migrant communities or in their countries of birth"|t }}
              </div>
            </div>
          </div>
        </div>
        <div class="fgm-prevalance-disclaimer light-font">
          <p>{{ "<strong>Note:</strong> Countries shaded in blue have FGM prevalence data collected by MICS, DHS and other nationally representative household surveys."|t }}</p>
          <p>{{ "The estimates of girls at risk are based on recent nationally representative survey data (DHS or MICS) that document the FGM experiences of women and girls in countries with a high prevalence of FGM, along with the revised national population projections published by the United Nations. Not all high-prevalence countries have sufficient data available to estimate the numbers of girls at risk."|t }}</p>
          <p>{{ "Countries with sufficient data to estimate the number of girls at risk include: Benin, Burkina Faso, Central African Republic, Chad, Côte d’Ivoire, Egypt, Ethiopia, the Gambia, Ghana, Guinea, Guinea-Bissau, Indonesia, Iraq, Kenya, Mali, Mauritania, Niger, Nigeria, Senegal, Sierra Leone, Somalia, the Sudan, Togo, the United Republic of Tanzania and Yemen. As the most recent data on FGM for Cameroon, Djibouti and Eritrea date back prior to 2010, these countries have not been included in this analysis. Uganda and Liberia had to be excluded from the analysis as the precise age of cutting was not recorded in the surveys."|t }}</p>
          <p>{{ "<strong>Sources:</strong> Demographic and Health Surveys (DHS); Multiple Indicator Cluster Surveys (MICS); United Nations Department of Economic and Social Affairs, Population Division, World Population Prospects 2017."|t }}</p>
        </div>
      </div>
{% endif %}

      {% if has_slider is not empty %}
      <div class="fgm-subpage-content light-font">
        <div class="fgm-subpage-slider fgm-subpage-imgtext">
          <div class="fgm-subpage-imgtext-img">
            <div class="fgm-subpage-slider-slider">
              <ul>
                {% for item in slider_image %}
                <li>
                  <div class="fgm-subpage-slider-img">
                    <img src="{{ item.img_slider }}">
                  </div>
                  <div class="fgm-subpage-slider-slide-caption element-hidden">
                    {{ item.img_caption|raw }}
                  </div>
                  <div class="fgm-subpage-slider-slide-credit element-hidden">
                    {{ item.img_credit|raw }}
                  </div>
                </li>
                {% endfor %}
              </ul>
            </div>
          </div>
          <div class="fgm-subpage-imgtext-text">
            <div class="fgm-subpage-slider-caption">
              {{ slider_image.0.img_caption|raw }}
            </div>
            <div class="fgm-subpage-slider-credit reg-font">
              {{ slider_image.0.img_credit|raw }}
            </div>
          </div>
        </div>
      </div>
      {% endif %}
    </div>

    {{ actions }}

    <a class="fgm-subpage-next" href="{{ next_url }}" style="background-image: url({{ next_img }}); ">
      <div class="fgm-subpage-next-inner">
        {% if next_pretitle is not empty %}
        <span class="fgm-subpage-next-pretitle conb-font">
          {{ next_pretitle }}
        </span>
        {% endif %}
        <span class="fgm-subpage-next-title conb-font">
          {{ next_title }}
        </span>
        <span class="fgm-subpage-next-arrow"></span>
      </div>
    </a>

  </article>

  {{ sharemodal }}
</div>
