<?php

/**
 * @file
 * Installation hooks for FGM Campaign module.
 */

/**
 * Implements hook_schema().
 */
function unfpa_global_fgm_campaign_schema() {
  $schema = [];

  $schema['unfpa_global_fgm_campaign_pledges'] = [
    'description' => 'Stores FGM Campaign pledge form submissions.',
    'fields' => [
      'sid' => [
        'description' => 'The primary identifier for a submission.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'country' => [
        'description' => 'Country code of the country that user selected during submission.',
        'type' => 'varchar',
        'length' => 2,
        'not null' => TRUE,
      ],
      'user_hash' => [
        'description' => 'Hash based on email of the user who submitted the form.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'ip_address' => [
        'description' => 'IP address of the user who submitted the form.',
        'type' => 'varchar',
        'length' => 45,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'description' => 'Time of submission.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => [
      'sid',
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function unfpa_global_fgm_campaign_install() {
  // Programmatically create initial pledges during installation.
  $initial_pledges = unfpa_global_fgm_campaign_pledge_initial_ammounts();

  // Initial pledges will use IP '0.0.0.0'.
  $ip = '0.0.0.0';

  foreach ($initial_pledges as $country => $ammount) {
    for ($i = 0; $i < $ammount; $i++) {
      unfpa_global_fgm_campaign_pledge_save_submission($country, '', $ip);
    }
  }
}

