    'ZW' => [
      'value' => 0,
      'color' => 2,
    ],
  ];

  // Format numbers.
  // First negotiate thousands separator sign.
  $thousands_sep = ',';
  if ($fgm_lang == 'es') {
    $thousands_sep = '.';
  }
  if ($fgm_lang == 'fr') {
    $thousands_sep = ' ';
  }

  // Process data array to format value numbers.
  foreach ($data as $key => $item) {
    // Skip 0 values.
    if (!$item['value']) {
      continue;
    }
    $value = number_format($item['value'], 0, '', $thousands_sep);
    $data[$key]['value'] = $value;
  }

  return $data;
}

/**
 * Load Constant Contact Classes and dependent classes.
 */
function loadConstantContactClasses($class) {
  if (in_array($class, ['Ctct\ConstantContact', 'Ctct\Contact'])) {
    $loader = include_once 'php-libs/contstant_contact/autoload.php';

    if ($loader->findFile($class)) {
      $loader->loadClass($class);
    }
  }
}


/**
 * Implements hook_page_attachments().
 */
function unfpa_global_fgm_campaign_page_attachments(array &$attachments) {

  $route_name = \Drupal::routeMatch()->getRouteName();
  $routes = [
    'unfpa_global_fgm_campaign.unfpa_global_fgm_campaign_data',
    'unfpa_global_fgm_campaign.unfpa_global_fgm_campaign_data_share_id',
  ];
  if (in_array($route_name, $routes)) {
    $share_id = \Drupal::requestStack()->getCurrentRequest()->get('share_id');
    $meta_tag_list = unfpa_global_fgm_campaign_add_metatag($share_id);
    foreach ($meta_tag_list as $key => $value) {
      $attachments['#attached']['html_head'][] = [$value, 'keywords' . $key];
    }

  }
}

/**
 * Get share tags locale in a form of 'en_US'.
 *
 * Used by og:locale sharing meta tag.
 *
 * @return string
 *   Locale information in form of 'en_US', 'fr_FR', etc.
 */
function unfpa_global_fgm_campaign_share_get_locale() {
  $lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $country = $lang;

  if ($lang == 'en') {
    $country = 'us';
  }

  return $lang . '_' . strtoupper($country);
}

/**
 * Function to get meta tag.
 */
function unfpa_global_fgm_campaign_add_metatag($share_id = FALSE) {

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $config = \Drupal::config('system.site');
  $route_name = \Drupal::routeMatch()->getRouteName();
  $data = \Drupal::service('unfpa_global_fgm_campaign.fgm_campaign_data')->unfpa_global_fgm_campaign_share_get_data($share_id);

  $share_url = $data['url'];
  $share_image = $data['img'];
  $share_title = $data['title'];
  $share_description = $data['description'];

  // Meta tags that don't change dynamically.
  $og_locale = unfpa_global_fgm_campaign_share_get_locale();
  $og_sitename = $config->get('name');
  $og_updated_time = time();
  $og_type = 'article';
  $og_image_type = 'image/jpeg';
  $tw_site = '@UNFPA';
  $tw_card = 'summary_large_image';
  $fb_app_id = \Drupal::state()->get('unfpa_global_common_facebook_app_id', '2280985865254142');

  $metatag = [
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:site',
       'content' => $tw_site,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
       'name' => 'twitter:card',
       'content' => $tw_card,
     ],
   ],
   [
     '#tag' => 'meta',
     '#attributes' => [
