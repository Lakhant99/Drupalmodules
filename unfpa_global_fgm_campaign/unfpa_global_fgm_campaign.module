/**
 * Saves selected data from pledge form submission into the database.
 *
 * @param $country
 *   Country code of the country that user selected during submission.
 * @param $email
 *   E-mail of the user who submitted the pledge form.
 * @param $ip
 *   IP address of the user who submitted the pledge form.
 */
function unfpa_global_fgm_campaign_pledge_save_submission($country, $email, $ip) {
  // For security reasons e-mails submitted via the pledge form are not
  // stored the in database as open text but as SHA-256 hashes.
  $hash = '0';
  if ($email != '') {
    $hash = hash('sha256', $email);
  }

  db_insert('unfpa_global_fgm_campaign_pledges')
    ->fields([
      'country' => $country,
      'user_hash' => $hash,
      'ip_address' => $ip,
      'timestamp' => time(),
    ])
    ->execute();
}

/**
 * Signup user to 'Constant Contact' FGM mailing list.
 */
function unfpa_global_fgm_campaign_constant_contact_signup($first_name, $last_name, $email) {
  $api_key = \Drupal::state()->get('unfpa_global_fgm_campaign_constant_contact_api_key', UNFPA_GLOBAL_FGM_CAMPAIGN_CONSTANT_CONTACT_API_KEY);
  $access_token = \Drupal::state()->get('unfpa_global_fgm_campaign_constant_contact_access_token', UNFPA_GLOBAL_FGM_CAMPAIGN_CONSTANT_CONTACT_ACCESS_TOKEN);

  // System id of 'FGM campaign 2019' mailing list in Constant Contact.
  // Separate mailing list for arabic and separate for other languages.
  $mailing_list_id = \Drupal::state()->get('unfpa_global_fgm_campaign_constant_contact_list_id', UNFPA_GLOBAL_FGM_CAMPAIGN_CONSTANT_CONTACT_LIST_ID);
  $fgm_lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if ($fgm_lang == 'ar') {
    $mailing_list_id = \Drupal::state()->get('unfpa_global_fgm_campaign_constant_contact_list_id_arabic', UNFPA_GLOBAL_FGM_CAMPAIGN_CONSTANT_CONTACT_LIST_ID_ARABIC);
  }

  // Do nothing if Constant Contact signup is disabled.
  if (!\Drupal::state()->get('unfpa_global_fgm_campaign_constantcontact_signup_enabled', 1)) {
    return;
  }

  try {
    $cc = new ConstantContact($api_key);

    // Try to get the contact.
    $response = $cc->contactService->getContacts($access_token, ['email' => $email]);

    // If contact doesn't exist create new contact and add it to mailing list.
    if (empty($response->results)) {
      // Create contact object.
      $contact = new Contact();
      $contact->first_name = $first_name;
      $contact->last_name = $last_name;
      $contact->status = 'ACTIVE';
      $contact->addEmail($email);
      // Add to list.
      $contact->addList($mailing_list_id);
      // Add contact.
      $cc->contactService->addContact($access_token, $contact, ['action_by' => 'ACTION_BY_VISITOR']);
    }

    // Otherwise just update existing contact.
    else {
      // Get contact object.
      $contact = $response->results[0];
      // Add to list.
      $contact->addList($mailing_list_id);
      // Update contact.
      $cc->contactService->updateContact($access_token, $contact, ['action_by' => 'ACTION_BY_VISITOR']);
    }
  }
  catch (Exception $ex) {
    // Logs an error.
    \Drupal::logger('unfpa_global_fgm_campaign')->error('Error while using Constant Contact PHP SDK: !error', ['!error' => print_r($ex->getMessage(), TRUE)]);
  }
}

/**
 * Preprocess variables for node--fgm.tpl.php.
 */
function unfpa_global_fgm_campaign_preprocess_node(&$variables) {
  global $base_url;
  $fgm_lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $curr_lang = ($fgm_lang == 'en') ? '' : '/' . $fgm_lang;
  $variables['base_url_wlang'] = $base_url . $curr_lang;
  $node = $variables['node'];
  $type = $node->getType();

  // We are only interested in FGM node type.
  if ($type != 'fgm') {
    return;
  }

  /* --- Attach assets --- */

  // Add js and css.
  $prevalance_data = unfpa_global_fgm_campaign_get_prevalance_data($fgm_lang);
  $variables['#attached'] = [
    'library' => ['unfpa_global_fgm_campaign/unfpa_global_fgm_campaign_details'],
    'drupalSettings' => [
      'unfpa_global_fgm_campaign' => [
        'prevalance_data' => $prevalance_data,
      ],
    ],
  ];

  /* --- Include Nav --- */
  $fgm_campaign_service = \Drupal::service('unfpa_global_fgm_campaign.fgm_campaign_data');
  $variables['nav'] = $fgm_campaign_service->unfpa_global_fgm_campaign_nav('page');

  /* --- Node Elements --- */

  // Color.
  $field_color = $node->field_color->getValue();
  $variables['title'] = $node->title->value;
  $variables['fgm_color'] = $field_color[0]['color'];

  // Next story link.
  $module_handler = \Drupal::service('module_handler');
  $module_path = $module_handler->getModule('unfpa_global_fgm_campaign')->getPath();
  $next_node = $node->field_next_story->target_id;
  // If there is next node then next story links to that node.
  if (isset($next_node)) {
    $next_nid = $next_node;
    $next_node = Node::load($next_nid);
    if (!is_null(Node::load($next_nid))) {      
      $next_node = Node::load($next_nid)->getTranslation($fgm_lang);
    }
    if(isset($next_node) && !empty($next_node)){
      $variables['next_url'] = $variables['base_url_wlang'] . \Drupal::service('path.alias_manager')->getAliasByPath('/node/' . $next_nid);
      $variables['next_pretitle'] = t('Next story');
      $variables['next_title'] = $next_node->getTitle();
      $variables['next_img'] = $base_url . '/' . $module_path . '/images/take-action.jpg';
      if (isset($next_node->field_link_image->target_id) && !empty($next_node->field_link_image->target_id)) {
        $link_image_file = File::load($next_node->field_link_image->target_id);
        $variables['next_img'] = file_create_url($link_image_file->getFileUri());
      }
    }
  }
  // Otherwise it links back to main page.
  else {
    $variables['next_url'] = Url::fromRoute('unfpa_global_fgm_campaign.unfpa_global_fgm_campaign_data')->toString() . '#map';
    $variables['next_pretitle'] = FALSE;
    $variables['next_title'] = t('Take action');
    $variables['next_img'] = $base_url . '/' . $module_path . '/images/take-action.jpg';
  }

  // Prevalance map.
  $prevalance_map_field = $node->field_include_prevalance_map->value;
  $variables['prevalance_map'] = '';
  if (isset($node->field_include_prevalance_map->value) && !empty($node->field_include_prevalance_map->value)) {
    $variables['prevalance_map'] = 1;
  }

  // Image slider.
  $slider_imgs_field = $node->field_image_slider_images->getValue();
  $variables['has_slider'] = FALSE;
  $variables['slider_image'] = [];

  if (isset($slider_imgs_field) && count($slider_imgs_field)) {
    $variables['has_slider'] = TRUE;
    $i = 0;
    $sliderData = [];
    foreach ($slider_imgs_field as $item) {
      $img_slider_file = File::load($item['target_id']);
      $sliderData[$i]['img_slider'] = file_create_url($img_slider_file->getFileUri());
      $sliderData[$i]['img_credit'] = $item['alt'];
      $sliderData[$i]['img_caption'] = $item['title'];
      $i++;
    }
  }
  $variables['slider_image'] = $sliderData;

  /* --- No markup rendering for selected fields. --- */

  // Use 'normakup' theme function for some fields, so they print without
  // extra HTML - just raw value without the nee d to override their tpl.php's.
  $variables['header_image'] = '';
  if (isset($node->field_image->target_id) && !empty($node->field_image->target_id)) {
    $header_image_file = File::load($node->field_image->target_id);
    $variables['header_image'] = file_create_url($header_image_file->getFileUri());
  }
  $variables['mobile_image'] = '';
  if (isset($node->field_mobile_banner->target_id) && !empty($node->field_mobile_banner->target_id)) {
    $mobile_image_file = File::load($node->field_mobile_banner->target_id);
    $variables['mobile_image'] = file_create_url($mobile_image_file->getFileUri());
  }
  $variables['subtitle'] = !empty($node->field_sub_title->value) ? $node->field_sub_title->value : '';
  $variables['header_image_credit'] = !empty($node->field_header_image_credit->value) ? $node->field_header_image_credit->value : '';
  $variables['body'] = $node->body->value;

  /* --- Actions. --- */

  $variables['actions'] = $fgm_campaign_service->unfpa_global_fgm_campaign_actions('1');

  /* --- Sharing. --- */

  $share_url = $variables['base_url_wlang'] . \Drupal::service('path.alias_manager')->getAliasByPath('/node/' . $node->id());
  $share_description = $node->field_share_description->value;
  if (isset($node->field_share_image->target_id) && !empty($node->field_share_image->target_id)) {
    $share_image_file = File::load($node->field_share_image->target_id);
    $share_img = file_create_url($share_image_file->getFileUri());
  }

  // Include share link.
  $sharelink = [
    'share_url' => $share_url,
    'share_img' => $share_img,
    'share_description' => $share_description,
    'color' => $variables['fgm_color'],
  ];

  $variables['sharelink'] = $fgm_campaign_service->unfpa_global_fgm_campaign_sharelink($sharelink);

  // Include share modal.
  $variables['sharemodal'] = $fgm_campaign_service->unfpa_global_fgm_campaign_sharemodal();

  $variables['include_prevalance_map'] = $node->field_include_prevalance_map->value;

}

