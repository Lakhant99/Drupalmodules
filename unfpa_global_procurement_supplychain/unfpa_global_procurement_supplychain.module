/**
 * Implements hook_preprocess_menu().
 */
function unfpa_global_procurement_supplychain_preprocess_menu(&$variables) {
  if (isset($variables['menu_name']) && $variables['menu_name'] == 'procurement-supplychain') {
    $img_arr = [
      'What we do' => '/images/icon-home.svg',
      'For Governments & Partners' => '/images/icon-calendar.svg',
      'For Suppliers' => '/images/icon-bereau-member.svg',
      'Products & Tools' => '/images/icon-doc.svg',
      'Resources' => '/images/icon-decisions.svg',
      'My Account' => '/images/icon-reports.svg',
    ];

    // Get Current Moduele path.
    $module_handler = \Drupal::service('module_handler');
    $module_path = $module_handler->getModule('unfpa_global_procurement_supplychain')->getPath();
    foreach ($variables['items'] as $key => $item) {
      if (isset($img_arr[$item['title']])) {
        $variables['items'][$key]['icon'] = "/{$module_path}{$img_arr[$item['title']]}";
      }
    }
  }
}

/**
 * Implements hook_preprocess_node().
 * Add view and map blocks to procurement nodes.
 */
function unfpa_global_procurement_supplychain_preprocess_node(&$variables) {
  if (!empty($variables['node'])) {
    $node = $variables['node'];
    if ($node->getType() == 'ct_procurement') {
      // Pass image data to js
      $banner_image = $mobile_image = NULL;
      if (!$node->get('field_banner_image')->isEmpty()) {
        $banner_image = $node->field_banner_image->entity->createFileUrl();
        $variables['#attached']['drupalSettings']['banner_image'] = $banner_image;
      }

      if (!$node->get('field_banner_image_mobile')->isEmpty()) {
        $mobile_image = $node->field_banner_image_mobile->entity->createFileUrl();
        $variables['#attached']['drupalSettings']['mobile_image'] = $mobile_image;
      }

      // Get node title.
      $node_title = $node->getTitle();

      // Render related topics
      $show_map = false;
      $related_topics_nodes = [
        'What we do' => 'procurement_related_content',
        'For Governments & Partners' => 'govt_partners_related_content',
      ];
      if (in_array($node_title, array_keys($related_topics_nodes))) {
        $show_related_topics = true;
        $variables['related_topics_param'] = $related_topics_nodes[$node_title];
      }

      // Render Map
      $show_related_topics = false;
      if (in_array($node_title, ['For Governments & Partners','Procurement and supply chain governments and partners'] )) {
        $show_map = true;

        // Get Map
        $govt_spending_obj =  \Drupal::service('unfpa_global_procurement_supplychain.govt_spending')->getGovernmentSpendingMapData();

        // Attach map variables and libraries
        $variables['#attached']['library'][] = 'unfpa_global_procurement_supplychain/government_partners';
        $variables['#attached']['drupalSettings']['location'] = $govt_spending_obj['location'];
        $variables['#attached']['drupalSettings']['country'] = $govt_spending_obj['country'];
      }

      $variables['show_related_topics'] = $show_related_topics;
      $variables['show_map'] = $show_map;
    }
  }
}

function unfpa_global_procurement_supplychain_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['#id']) && $form['#id'] == 'views-exposed-form-procurement-supplychain-resources-supplies-resources') {
    $options = [];
    $options[''] = new TranslatableMarkup('-Year');
    $query = \Drupal::entityQuery('node');
    $query->condition('type', 'ct_resources')
      ->condition('status', 1)
      ->sort('field_date', 'DESC');
    $result = $query->execute();
    if ($result) {
      $nodes =  \Drupal\node\Entity\Node::loadMultiple($result);
      foreach ($nodes as $node) {
        $date = $node->field_date->value;
        if ($date) {
          $date = new DrupalDateTime($date, new DateTimeZone('UTC'));
          $year = $date->format('Y');
          if (!isset($options[$year]) && $year >= "2007") {
            $options[$year] = $year;
          }
        }
      }
    }
    $test = $options;
    $form['field_date_value'] = [
      '#type' => 'select',
      '#options' => $options,
      '#size' => NULL,
      '#default_value' => 'All',
    ];
  }
}