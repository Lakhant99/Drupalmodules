{# Set content path and title #}
{% set path = fields.view_node.content|striptags|trim %}
{# Set content type #}
{% if fields.field_news_type.content is not empty and fields.type.content == 'ct_news' %}
  {% set type = fields.field_news_type.content %}
{% else %}
  {% set type = fields.type_1.content %}
{% endif %}

{% set content_title = fields.title.content|striptags|trim %}
{# see more btn #}
{% if fields.type.content == 'ct_resources' %}
  {% set readmore = 'See resources'|t %}
{% elseif fields.type.content == 'ct_events' %}
  {% set readmore = 'See Events'|t %}
{% elseif fields.type.content == 'ct_news' %}
  {% set readmore = 'Read the story'|t %}
{% elseif fields.type.content == 'ct_video' %}
  {% set readmore = 'Watch the video'|t %}
{% elseif fields.type.content == 'ct_updates' %}
  {% set readmore = 'Read the story'|t %}
{% else %}
  {% set readmore = 'Read the story'|t %}
{% endif %}

{# Set content image url #}
{% if  fields.field_feature_banner_image.content is empty and  fields.type.content == 'ct_resources' %}
  {% set img_url = fields.field_resource_cover_image.content %}
{% elseif fields.field_feature_banner_image.content is empty and  fields.type.content == 'ct_events' %}
  {% set img_url = fields.field_photo.content %}
{% elseif fields.field_banner_image_ipad.content is not empty and  fields.type.content == 'ct_project_page' %}
  {% set img_url = fields.field_banner_image_ipad.content %}
{% elseif fields.field_feature_banner_image.content is not empty and  fields.type.content == 'ct_news' %}
  {% set img_url = fields.field_feature_banner_image.content %}
{% elseif fields.field_feature_banner_image.content is not empty %}
  {% set img_url = fields.field_feature_banner_image.content %}
{% else %}
  {% set img_url = base_path ~ directory ~ '/images/placeholders/' ~ fields.type.content ~ '_' ~  fields.langcode.content ~ '.gif' %}
{% endif %}
{% if img_url is empty %}
  {% set img_url = base_path ~ directory ~ '/images/placeholders/' ~ fields.type.content ~ '_' ~  fields.langcode.content ~ '.gif' %}
{% endif %}
<div class="ct-card">
  <div class="ct-card__image publication">
    {% if fields.type.content == 'ct_video' %}
      {{fields.field_video.content}}
    {% endif %}
    {% if fields.type.content == 'ct_resources' %}
      <img class="img-blur" src="{{ img_url }}" alt="{{ content_title }}" title="{{ content_title }}">
    {% endif %}
    {% if (fields.type.content == 'ct_news') or (fields.type.content == 'ct_events') %}
      <img class="img-blur" src="{{ img_url }}" alt="{{ content_title }}" title="{{ content_title }}">
    {% endif %}
    <a href="{{ path }}">
      <img src="{{ img_url }}" alt="{{ content_title }}" title="{{ content_title }}">
    </a>
  </div>
  <div class="ct-card__details">
    <div class="ct-card__details--body">
      <p class="content-type">{{ type }}</p>
      <h3 class="card-title"><a href="{{ path }}">{{ content_title }}</a></h3>
      <a href="{{path}}" class="btn">{{ readmore }}<i class="secondary-arrow"></i>
      </a>
    </div>
  </div>
</div>
